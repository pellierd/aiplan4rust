pub Requirement : Box<Ast> = {
    <start:@L> ":strips" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::Strips), Vec::new(), start, end))
    },
    <start:@L> ":typing" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::Typing), Vec::new(), start, end))
    },
    <start:@L> ":equality" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::Equality), Vec::new(), start, end))
    },
    <start:@L> ":negative-preconditions" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::NegativePreconditions), Vec::new(), start, end))
    },
    <start:@L> ":disjunctive-preconditions" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::DisjunctivePreconditions), Vec::new(), start, end))
    },
    <start:@L> ":existential-preconditions" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::ExistentialPreconditions), Vec::new(), start, end))
    },
    <start:@L> ":universal-preconditions" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::UniversalPreconditions), Vec::new(), start, end))
    },
    <start:@L> ":quantified-preconditions" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::QuantifiedPreconditions), Vec::new(), start, end))
    },
    <start:@L> ":conditional-effects" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::ConditionalEffects), Vec::new(), start, end))
    },
    <start:@L> ":fluents" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::Fluents), Vec::new(), start, end))
    },
    <start:@L> ":numeric-fluents" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::NumericFluents), Vec::new(), start, end))
    },
    <start:@L> ":adl" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::Adl), Vec::new(), start, end))
    },
    <start:@L> ":durative-actions" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::DurativeActions), Vec::new(), start, end))
    },
    <start:@L> ":duration-inequalities" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::DurationInequalities), Vec::new(), start, end))
    },
    <start:@L> ":continuous-effects" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::ContinuousEffects), Vec::new(), start, end))
    },
    <start:@L> ":derived-predicates" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::DerivedPredicates), Vec::new(), start, end))
    },
    <start:@L> ":timed-initial-literals" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::TimedInitialLiterals), Vec::new(), start, end))
    },
    <start:@L> ":preferences" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::Preferences), Vec::new(), start, end))
    },
    <start:@L> ":constraints" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::Constraints), Vec::new(), start, end))
    },
    <start:@L> ":action-costs" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::ActionCosts), Vec::new(), start, end))
    },
    <start:@L> <error:!> <end:@R>  => {
        errors.push(error);
        Box::new(Ast::new(AstKind::Error, Vec::new(), start, end))
    },
}

pub RequireDef : Box<Ast> = {
     <start:@L> "(" ":requirements" <requirements:Requirement*> ")" <end:@R> => {
        Box::new(Ast::new(AstKind::RequireDef, requirements, start, end))
     },
}

pub Type : Box<Ast> = {
    <start:@L> <t:PrimitiveType> <end:@R> => {
        let mut children = Vec::new();
        children.push(t);
        Box::new(Ast::new(AstKind::Type, children, start, end))
    },
    <start:@L> "(" "either" <types:PrimitiveType+> ")" <end:@R> => {
        Box::new(Ast::new(AstKind::Type, types, start, end))
    },
}

TypedList<T>: Box<Ast> = {
   <start:@L>  <list:T*> <end:@R> => {
        let mut children = Vec::new();
        children.extend(list);
        Box::new(Ast::new(AstKind::TypedList, children, start, end))
    },
    <start:@L> <list:T+>  "-" <ty:Type> <end:@R> <next:TypedList<T>> => {
        let mut children = Vec::new();
        children.extend(list);
        children.push(ty);
        children.push(next);
        Box::new(Ast::new(AstKind::TypedList, children, start, end))
    },
}

