pub TypesDef : Box<Ast> = {
    <start:@L> "(" ":types" <types:TypedList<PrimitiveType>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(types);
        Box::new(Ast::new(AstKind::TypesDef, children , start, end))
     },
}

pub ConstantsDef : Box<Ast> = {
    <start:@L> "(" ":constants" <constants:TypedList<Constant>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(constants);
        Box::new(Ast::new(AstKind::ConstantsDef, children , start, end))
     },
}

pub PredicatesDef : Box<Ast> = {
     <start:@L> "(" ":predicates" <predicates:AtomicFormulaSkeleton+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(predicates);
        Box::new(Ast::new(AstKind::PredicatesDef, children , start, end))
    },
}
pub AtomicFormulaSkeleton : Box<Ast> = {
    <start:@L> "(" <predicate:Predicate> <arguments:TypedList<Variable>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(predicate);
        children.push(arguments);
        Box::new(Ast::new(AstKind::AtomicFormulaSkeleton, children , start, end))
    }
}

pub FunctionsDef :  Box<Ast> = {
    <start:@L> "(" ":functions" <functions:TypedList<AtomicFunctionSkeleton>>  ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(functions);
        Box::new(Ast::new(AstKind::FunctionsDef, children , start, end))
    }
}

pub AtomicFunctionSkeleton : Box<Ast> = {
    <start:@L> "(" <functor:FunctionSymbol> <arguments:TypedList<Variable>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(functor);
        children.push(arguments);
        Box::new(Ast::new(AstKind::AtomicFunctionSkeleton, children , start, end))
    }
}

pub StructureDef : Box<Ast> = {
    <action:ActionDef> =>  action,
    <derived:DerivedDef> => derived,
    <durative_action:DurativeActionDef> => durative_action,
}

pub ActionDef : Box<Ast> = {
    <start:@L>
        "(" ":action"
            <name:ActionSymbol>
            <parameters:ParameterDef>
            <body:ActionDefBody>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        children.push(parameters);
        children.push(body);
        Box::new(Ast::new(AstKind::ActionDef, children , start, end))
    }
}

pub ParameterDef : Box<Ast> = {
    <start:@L>
       ":parameters" "(" <parameters:TypedList<Variable>> ")"
    <end:@R>  => {
        let mut children = Vec::new();
        children.push(parameters);
        Box::new(Ast::new(AstKind::ParameterDef, children , start, end))
    }
}

pub ActionDefBody : Box<Ast> = {
    <start:@L>
        <precondition:PreconditionDef?>
        <effect:EffectDef?>
    <end:@R>  => {
        let mut children = Vec::new();
        if let Some(precondition) = precondition {
            children.push(precondition);
        }
        if let Some(effect) = effect {
            children.push(effect);
        }
        Box::new(Ast::new(AstKind::ActionDefBody, children , start, end))
    }
}

pub PreconditionDef : Box<Ast> = {
    <start:@L>
        ":precondition" <precondition:EmptyOr<PreGD>>
    <end:@R>  => {
        let mut children = Vec::new();
        children.push(precondition);
        Box::new(Ast::new(AstKind::PreconditionDef, children , start, end))
    }
}

pub EffectDef : Box<Ast> = {
    <start:@L>
        ":effect" <effect:EmptyOr<Effect>>
    <end:@R>  => {
        let mut children = Vec::new();
        children.push(effect);
        Box::new(Ast::new(AstKind::EffectDef, children , start, end))
    }
}

EmptyOr<T> : Box<Ast> = {
    <start:@L> "(" ")" <end:@R> => {
        Box::new(Ast::new(AstKind::Or, Vec::new(), start, end))
    },
    <start:@L> <element:T> <end:@R> => {
        let mut children = Vec::new();
        children.push(element);
        Box::new(Ast::new(AstKind::Or, children, start, end))
    },
}

pub PreGD : Box<Ast> = {
    <start:@L> <pref_gd:PrefGD> <end:@R> => pref_gd,
    //<start:@L> <gd:GD> <end:@R> => gd,
    <atom:AtomicFormula<Term>> => atom,
    <start:@L> "(" "and" <pre_gd:PreGD*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(pre_gd);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
    <start:@L> "(" "or" <gd:GD*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(gd);
        Box::new(Ast::new(AstKind::Or, children, start, end))
    },
    <start:@L> "(" "not" <gd:GD> ")" <end:@R> => {
         let mut children = Vec::new();
         children.push(gd);
         Box::new(Ast::new(AstKind::Not, children, start, end))
    },
    <start:@L> "(" "imply" <antecedent:GD> <consequence:GD>")" <end:@R>  => {
        let mut children = Vec::new();
        children.push(antecedent);
        children.push(consequence);
        Box::new(Ast::new(AstKind::Imply, children, start, end))
    },
    <start:@L>
        "(" "exists"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(gd);
        Box::new(Ast::new(AstKind::Exists, children, start, end))
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <pre_gd:PreGD>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(pre_gd);
        Box::new(Ast::new(AstKind::Forall, children, start, end))
    },
    <fcomp:FComp> => fcomp,
}

pub PrefGD : Box<Ast> = {
    <start:@L> "(" "preference" <pref_name:PrefName?> <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        if let Some(pref_name) = pref_name {
            children.push(pref_name);
        }
        children.push(gd);
        Box::new(Ast::new(AstKind::Preference, children , start, end))
    },
}

pub GD : Box<Ast> = {
    <atom:AtomicFormula<Term>> => atom,
    <start:@L> "(" "and" <gd:GD*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(gd);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
    <start:@L> "(" "or" <gd:GD*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(gd);
        Box::new(Ast::new(AstKind::Or, children, start, end))
    },
    <start:@L> "(" "not" <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(gd);
        Box::new(Ast::new(AstKind::Not, children, start, end))
    },
    <start:@L> "(" "imply" <antecedent:GD> <consequence:GD>")" <end:@R>  => {
        let mut children = Vec::new();
        children.push(antecedent);
        children.push(consequence);
        Box::new(Ast::new(AstKind::Imply, children, start, end))
    },
     <start:@L>
        "(" "exists"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(gd);
        Box::new(Ast::new(AstKind::Exists, children, start, end))
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(gd);
        Box::new(Ast::new(AstKind::Forall, children, start, end))
    },
    <fcomp:FComp> => fcomp,
}

pub Effect : Box<Ast> = {
    <start:@L> "(" "and" <effects:CEffect*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(effects);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
    <effect:CEffect> => effect,
}

pub CEffect : Box<Ast> = {
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <effect:Effect>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(effect);
        Box::new(Ast::new(AstKind::Forall, children, start, end))
    },
    <start:@L> "(" "when" <gd:GD> <effect:CondEffect> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(gd);
        children.push(effect);
        Box::new(Ast::new(AstKind::When, children, start, end))
    },
    <effect:PEffect> => effect,
}

pub PEffect : Box<Ast> = {
    <literal:Literal<Term>> => literal,
    <start:@L> "(" <op:AssignOp> <fhead:FHead> <fexp:_FExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(fhead);
        children.push(fexp);
        Box::new(Ast::new(AstKind::Assign(op), children, start, end))
    },
}

pub CondEffect : Box<Ast> = {
    <start:@L> "(" "and" <effects:PEffect*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(effects);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
    <effect:PEffect> => effect,
}

pub Term: Box<Ast> = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            Box::new(Ast::new(AstKind::Constant(name.to_string()), Vec::new(), start, end))
        } else {
            Box::new(Ast::new(AstKind::Variable(name.to_string()), Vec::new(), start, end))
        }
    },
    <duration:DurationVariable> => duration,
    <function:FunctionTerm> => function,
}

pub FunctionTerm: Box<Ast> = {
    <function_term:_FunctionTerm<Term>> => function_term
}

_FunctionTerm<T>: Box<Ast> = {
   <start:@L> "(" <function_symbol:FunctionSymbol> <arguments:T*> ")" <end:@R> => {
            let mut children = Vec::new();
            children.push(function_symbol);
            children.extend(arguments);
            Box::new(Ast::new(AstKind::FunctionTerm, children, start, end))
       },
}

pub FComp : Box<Ast> = {
    <start:@L> "(" <comparator:BinaryComp> <arg1:_FExp> <arg2:_FExp> ")"  <end:@R> => {
        let mut children = Vec::new();
         children.push(arg1);
         children.push(arg2);
         Box::new(Ast::new(AstKind::FComp(comparator), children, start, end))
    },
}

pub BinaryComp : BinaryComp = {
    ">" => BinaryComp::Greater,
    "<" => BinaryComp::Less,
    "=" => BinaryComp::Equal,
    ">=" => BinaryComp::GreaterEq,
    "<=" => BinaryComp::LessEq,
}

pub AssignOp : AssignOp = {
    "assign" => AssignOp::Assign,
    "scale-up" => AssignOp::ScaleUp,
    "scale-down" => AssignOp::ScaleDown,
    "increase" => AssignOp::Increase,
    "decrease" => AssignOp::Decrease,
}

pub ArithmeticOp : ArithmeticOp = {
    "-" => ArithmeticOp::Sub,
    "+" => ArithmeticOp::Add,
    "/" => ArithmeticOp::Div,
    "*" => ArithmeticOp::Mul,
}

Literal<T> : Box<Ast> = {
    <atom:AtomicFormula<T>> => atom,
    <start:@L> "(" "not" <atom:AtomicFormula<T>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(atom);
        Box::new(Ast::new(AstKind::Not, children, start, end))
    },
}

AtomicFormula<T> : Box<Ast> = {
    <start:@L> "(" <predicate:Predicate> <terms:T*> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.push(predicate);
        children.extend(terms);
        Box::new(Ast::new(AstKind::AtomicFormula, children, start, end))
    },
}

_FExp : Box<Ast> = {
    <term:Term> => term,
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:_FExp> <arg2:_FExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Sub), children, start, end))
    },
    <start:@L> "(" "/" <arg1:_FExp> <arg2:_FExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.push(arg2);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Div), children, start, end))
    },
    <start:@L> "(" "+" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Add), children, start, end))
    },
    <start:@L> "(" "*" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Mul), children, start, end))
    },
}

pub FExp : Box<Ast> = {
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:FExp> <arg2:FExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Sub), children, start, end))
    },
    <start:@L> "(" "/" <arg1:FExp> <arg2:FExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.push(arg2);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Div), children, start, end))
    },
    <start:@L> "(" "+" <arg1:FExp> <next_args:FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Add), children, start, end))
    },
    <start:@L> "(" "*" <arg1:FExp> <next_args:FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Mul), children, start, end))
    },
    <fhead:FHead> => fhead,
}

pub FExpDA : Box<Ast> = {
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:FExpDA> <arg2:FExpDA?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Sub), children, start, end))
    },
    <start:@L> "(" "/" <arg1:FExpDA> <arg2:FExpDA> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.push(arg2);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Div), children, start, end))
    },
    <start:@L> "(" "+" <arg1:FExpDA> <next_args:FExpDA+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Add), children, start, end))
    },
    <start:@L> "(" "*" <arg1:FExpDA> <next_args:FExpDA+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Mul), children, start, end))
    },
    <fhead:FHead> => fhead, // Add to accept the good syntax
    //<fexp:FExp> => fexp, // Remove for conflict
    <duration:DurationVariable> => duration,
}

pub FHead: Box<Ast> = {
    <function:FunctionTerm> => function,
     <start:@L> <symbol:FunctionSymbol> <end:@R> => {
        let mut children = Vec::new();
        children.push(symbol);
        Box::new(Ast::new(AstKind::FunctionTerm, children, start, end))
    }
}

pub Constraints : Box<Ast> = {
    <start:@L> "(" ":constraints" <con_gd:ConGD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(con_gd);
        Box::new(Ast::new(AstKind::Constraints, children, start, end))
    },
}

pub ConGD : Box<Ast> = {
    <start:@L> "(" "and" <con_gd:ConGD*> ")" <end:@R> => {
         let mut children = Vec::new();
        children.extend(con_gd);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")"
            <end_var:@R> <con_gd:ConGD>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(con_gd);
        Box::new(Ast::new(AstKind::Forall, children, start, end))
    },
    <start:@L> "(" "at end" <gd:GD> ")"<end:@R> => {
        let mut children = Vec::new();
        children.push(gd);
        Box::new(Ast::new(AstKind::AtEnd, children, start, end))
    },
    <start:@L> "(" "always" <gd:GD> ")"<end:@R> => {
        let mut children = Vec::new();
        children.push(gd);
        Box::new(Ast::new(AstKind::Always, children, start, end))
    },
    <start:@L> "(" "sometime" <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(gd);
        Box::new(Ast::new(AstKind::Sometime, children, start, end))
    },
    <start:@L> "(" "within" <number:Number> <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(number);
        children.push(gd);
        Box::new(Ast::new(AstKind::Within, children, start, end))
    },
    <start:@L> "(" "at-most-once" <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(gd);
        Box::new(Ast::new(AstKind::AtMostOnce, children, start, end))
    },
    <start:@L> "(" "sometime-after" <gd1:GD> <gd2:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(gd1);
        children.push(gd2);
        Box::new(Ast::new(AstKind::SometimeAfter, children, start, end))
    },
    <start:@L> "(" "sometime-before" <gd1:GD> <gd2:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(gd1);
        children.push(gd2);
        Box::new(Ast::new(AstKind::SometimeBefore, children, start, end))
    },
    <start:@L> "(" "always-within" <number:Number> <gd1:GD> <gd2:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(number);
        children.push(gd1);
        children.push(gd2);
        Box::new(Ast::new(AstKind::AlwaysWithin, children, start, end))
    },
    <start:@L> "(" "hold-during" <lower:Number> <upper:Number> <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(lower);
        children.push(upper);
        children.push(gd);
        Box::new(Ast::new(AstKind::HoldDuring, children, start, end))
    },
    <start:@L> "(" "hold-after" <number:Number> <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(number);
        children.push(gd);
        Box::new(Ast::new(AstKind::HoldAfter, children, start, end))
    },
}

