pub FExpT : Box<Ast> = {
    <start:@L> "(" "*" <fexp:FExp> <var:ContinusVariable> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(fexp);
        children.push(var);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Mul), children, start, end))
    },
    <start:@L> "(" "*" <var:ContinusVariable> <fexp:FExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(var);
        children.push(fexp);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Mul), children, start, end))
    },
