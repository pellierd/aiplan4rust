}

pub ContinusVariable : Box<Ast> = {
    <start:@L> <var:"#t"> <end:@R> => {
        Box::new(Ast::new(AstKind::Variable(var.to_string()), Vec::new(), start, end))
    }
}

pub Domain : Box<Ast> = {
    <start:@L>
        "(" "define" "(" "domain" <name:DomainName> ")"
            <require_def:RequireDef?>
            <types_def:TypesDef?>
            <constants_def:ConstantsDef?>
            <predicates_def:PredicatesDef?>
            <functions_def:FunctionsDef?>
            <constraints:Constraints?>
            <structure_def:StructureDef*>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        if let Some(require_def) = require_def {
            children.push(require_def);
        }
        if let Some(types_def) = types_def {
            children.push(types_def);
        }
        if let Some(constants_def) = constants_def {
            children.push(constants_def);
        }
        if let Some(predicates_def) = predicates_def {
            children.push(predicates_def);
        }
        if let Some(functions_def) = functions_def {
            children.push(functions_def);
        }
        if let Some(constraints) = constraints {
            children.push(constraints);
        }

        children.extend(structure_def);
        Box::new(Ast::new(AstKind::Domain, children, start, end))
    },
 }

pub ObjectsDef : Box<Ast> = {
    <start:@L> "(" ":objects" <objects:TypedList<Constant>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(objects);
        Box::new(Ast::new(AstKind::ObjectsDef, children , start, end))
    },
}

pub BasicFunctionTerm : Box<Ast> = {
    <function:FunctionTerm> => function,
    <symbol:FunctionSymbol> => symbol,
}

pub InitEl : Box<Ast> = {
    <literal:Literal<Constant>> => literal,
    <start:@L> "(" <number:Number> <literal:Literal<Constant>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(number);
        children.push(literal);
        Box::new(Ast::new(AstKind::TimedInitialLiteral, children , start, end))
    },
    <start:@L> "(" "=" <function:BasicFunctionTerm> <number:Number> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.push(function);
        children.push(number);
        Box::new(Ast::new(AstKind::FComp(BinaryComp::Equal), children , start, end))
    },
    <start:@L> "(" "=" <function:BasicFunctionTerm> <constant:Constant> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.push(function);
        children.push(constant);
        Box::new(Ast::new(AstKind::FComp(BinaryComp::Equal), children , start, end))
    },
}

pub Init : Box<Ast> = {
    <start:@L> "(" ":init" <init_els:InitEl*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(init_els);
        Box::new(Ast::new(AstKind::Init, children , start, end))
    },
}

pub Goal : Box<Ast> = {
     <start:@L> "(" ":goal" <pre_gd:PreGD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(pre_gd);
        Box::new(Ast::new(AstKind::Goal, children , start, end))
     },
}

pub Optimization : Optimization = {
    "minimize" => Optimization::Minimize,
    "maximize" => Optimization::Maximize,
}

pub MetricFExp : Box<Ast> = {
    <number:Number> => number,
    <function:_FunctionTerm<Constant>> => function,
    <start:@L> <symbol:FunctionSymbol> <end:@R> => {
        let mut children = Vec::new();
        children.push(symbol);
        Box::new(Ast::new(AstKind::FunctionTerm, children, start, end))
    },
    <start:@L> "(" "-" <arg1:MetricFExp> <arg2:MetricFExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Sub), children, start, end))
    },
    <start:@L> "(" "/" <arg1:MetricFExp> <arg2:MetricFExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.push(arg2);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Div), children, start, end))
    },
    <start:@L> "(" "+" <arg1:MetricFExp> <next_args:MetricFExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Add), children, start, end))
    },
    <start:@L> "(" "*" <arg1:MetricFExp> <next_args:MetricFExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(Ast::new(AstKind::Operation(ArithmeticOp::Mul), children, start, end))
    },
    //<start:@L> "total-time" <end:@R> => {
    //    Box::new(Ast::new(AstKind::TotalTime, Vec::new(), start, end))
    //},
    <start:@L> "(" "is-violated" <pref:PrefName> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(pref);
        Box::new(Ast::new(AstKind::IsViolated, Vec::new(), start, end))
    },
}

pub MetricSpec : Box<Ast> = {
    <start:@L> "(" ":metric" <op:Optimization> <fexp:MetricFExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(fexp);
        Box::new(Ast::new(AstKind::Metric(op), children, start, end))
    },
}

pub Length : Box<Ast> = {
    <start:@L>
        "(" ":length"
            <start_serial:@L> "(" ":serial" <serial_value:"number"?> ")" <end_serial:@R>
            <start_parallel:@L> "(" ":parallel" <parallel_value:"number"?> ")" <end_parallel:@R>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        if let Some(serial_value) = serial_value {
            children.push(Box::new(Ast::new(AstKind::Serial(OrderedFloat(serial_value)), Vec::new(), start_serial, end_serial)));
        }
        if let Some(parallel_value) = parallel_value {
            children.push(Box::new(Ast::new(AstKind::Parallel(OrderedFloat(parallel_value)), Vec::new(), start_parallel, end_parallel)));
        }
        Box::new(Ast::new(AstKind::Length, children, start, end))
    },
}

pub Problem : Box<Ast> = {
    <start:@L>
        "(" "define" "(" "problem" <problem:ProblemName> ")"
        "(" ":domain" <domain:DomainName> ")"
        <require_def:RequireDef?>
        <objects_def:ObjectsDef?>
        <init:Init>
        <goal:Goal>
        <constraints:Constraints?>
        <metric_spec:MetricSpec?>
        <length_spec:Length?>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(problem);
        children.push(domain);
        if let Some(require_def) = require_def {
           children.push(require_def);
        }
        if let Some(objects_def) = objects_def {
           children.push(objects_def);
        }
        children.push(init);
        children.push(goal);
        if let Some(constraints) = constraints {
            children.push(constraints);
        }
        if let Some(metric_spec) = metric_spec {
            children.push(metric_spec);
        }
        if let Some(length_spec) = length_spec {
            children.push(length_spec);
        }
        Box::new(Ast::new(AstKind::Problem, children, start, end))
    },
}

pub PDDL : Box<Ast> = {
    <domain:Domain> => domain,
    <problem:Problem> => problem,
}

///////////////////////////////////////////////////////////////////////////////////////////////
// HDDL Dialect
///////////////////////////////////////////////////////////////////////////////////////////////

pub TaskSymbol : Box<Ast> = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => Box::new(Ast::new(AstKind::TaskSymbol(name.to_string()), Vec::new(), start, end)),
            Err(_) => Box::new(Ast::new(AstKind::Error, Vec::new(), start, end)),
        }
    },
}

pub TaskDef : Box<Ast> = {
    <start:@L> "(" ":task" <symbol:TaskSymbol> <parameters:ParameterDef> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(symbol);
        children.push(parameters);
        Box::new(Ast::new(AstKind::TaskDef, children, start, end))
    },
}

pub MethodSymbol : Box<Ast> = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => Box::new(Ast::new(AstKind::MethodSymbol(name.to_string()), Vec::new(), start, end)),
            Err(_) => Box::new(Ast::new(AstKind::Error, Vec::new(), start, end)),
        }
    },
}

pub TaskID : Box<Ast> = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => Box::new(Ast::new(AstKind::TaskID(name.to_string()), Vec::new(), start, end)),
            Err(_) => Box::new(Ast::new(AstKind::Error, Vec::new(), start, end)),
        }
    },
}

pub TaskTerm: Box<Ast> = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            Box::new(Ast::new(AstKind::Constant(name.to_string()), Vec::new(), start, end))
        } else {
            Box::new(Ast::new(AstKind::Variable(name.to_string()), Vec::new(), start, end))
        }
    },
}

pub Task : Box<Ast> = {
    <start:@L> "(" <symbol:TaskSymbol> <terms:TaskTerm*> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.push(symbol);
        children.extend(terms);
        Box::new(Ast::new(AstKind::Task, children, start, end))
    },
}

pub Subtask: Box<Ast> = {
    <start:@L> "(" <name:Name> <rest:SubtaskRest> <end:@R> => {
        match name {
            Ok(name_value) => {
                match rest.first().map(|node| node.kind()) {
                    Some(AstKind::TaskSymbol(_)) => {
                        let mut children = Vec::new();
                        let task_id = Box::new(Ast::new(AstKind::TaskID(name_value), Vec::new(), start, end));
                        children.push(task_id);
                        children.extend(rest);
                        Box::new(Ast::new(AstKind::TaggedTask, children, start, end))
                    },
                    Some(AstKind::Constant(_)) | Some(AstKind::Variable(_)) => {
                        let mut children = Vec::new();
                        let task_symbol = Box::new(Ast::new(AstKind::TaskSymbol(name_value), Vec::new(), start, end));
                        children.push(task_symbol);
                        children.extend(rest);
                        Box::new(Ast::new(AstKind::Task, children, start, end))
                    },
                    _ => {
                        Box::new(Ast::new(AstKind::Error, Vec::new(), start, end))
                    }
                }
            },
            Err(_) => {
                Box::new(Ast::new(AstKind::Error, Vec::new(), start, end))
            }
        }
    },
}

SubtaskRest : Vec<Box<Ast>> = {
    <start:@L> "(" <task_symbol:TaskSymbol> <terms:TaskTerm*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(task_symbol);
        children.extend(terms);
        children
    },
    <start:@L> <terms:TaskTerm*> ")" <end:@R> => terms,
}

pub SubtaskDef : Box<Ast> = {
    <start:@L> <subtask:Subtask> <end:@R> => subtask,
    <start:@L> "(" ")" <end:@R> => {
        Box::new(Ast::new(AstKind::And, Vec::new(), start, end))
    },
    <start:@L> "(" "and" <subtasks:Subtask+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(subtasks);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
}

pub TaskNetworkdSubtaskDef: Box<Ast> = {
    <start:@L> ":ordered-tasks" <subtasks:SubtaskDef> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtasks);
        Box::new(Ast::new(AstKind::OrderedSubtaskDef, Vec::new(), start, end))
    },
    <start:@L> ":ordered-subtasks" <subtasks:SubtaskDef> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtasks);
        Box::new(Ast::new(AstKind::OrderedSubtaskDef, Vec::new(), start, end))
    },
    <start:@L> ":tasks" <subtasks:SubtaskDef> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtasks);
        Box::new(Ast::new(AstKind::PartiallyOrderedSubtaskDef, Vec::new(), start, end))
    },
    <start:@L> ":subtasks" <subtasks:SubtaskDef> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtasks);
        Box::new(Ast::new(AstKind::PartiallyOrderedSubtaskDef, Vec::new(), start, end))
    },
};

pub SimpleTaskNetworkOrderingConstraint : Box<Ast> = {
    <start:@L> "(" <t1:TaskID> "<" <t2:TaskID> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(t1);
        children.push(t2);
        Box::new(Ast::new(AstKind::FComp(BinaryComp::Less), children, start, end))
    },
}

pub TaskNetworkOrderingConstraint : Box<Ast> = {
    <constraint:SimpleTaskNetworkOrderingConstraint> => constraint,
    <start:@L> "(" ")" <end:@R> => {
            Box::new(Ast::new(AstKind::And, Vec::new(), start, end))
    },
    <start:@L> "(" "and" <constraints:SimpleTaskNetworkOrderingConstraint+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(constraints);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
}

pub TaskNetworkOrderingConstraintDef : Box<Ast> = {
    <start:@L> ":ordering" <constraint:TaskNetworkOrderingConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        Box::new(Ast::new(AstKind::TaskNetworkOrderingConstraintDef, children, start, end))
    },
     <start:@L> ":order" <constraint:TaskNetworkOrderingConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        Box::new(Ast::new(AstKind::TaskNetworkOrderingConstraintDef, children, start, end))
    },
}

pub SimpleTaskNetworkLogicalConstraint : Box<Ast> = {
    <start:@L>
        "(" "=" <t1:Term> <t2:Term> ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(t1);
        children.push(t2);
        Box::new(Ast::new(AstKind::FComp(BinaryComp::Equal), children, start, end))
    },
}

pub TaskNetworkLogicalConstraint : Box<Ast> = {
    <start:@L> "(" ")" <end:@R> => {
        Box::new(Ast::new(AstKind::And, Vec::new(), start, end))
    },
    <constraint:SimpleTaskNetworkLogicalConstraint> => constraint,
    <start:@L> "(" "not" <constraint:SimpleTaskNetworkLogicalConstraint> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        Box::new(Ast::new(AstKind::Not, children, start, end))
    },
}

pub TaskNetworkLogicalConstraintDef : Box<Ast> = {
    <start:@L> ":constraints" <constraint:TaskNetworkLogicalConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        Box::new(Ast::new(AstKind::TaskNetworkLogicalConstraintDef, children, start, end))
    },
}

pub TaskNetworkDef : Box<Ast> = {
    <start:@L>
        <subtasks:TaskNetworkdSubtaskDef?>
        <ordering_constraints:TaskNetworkOrderingConstraintDef?>
        <logical_constraints:TaskNetworkLogicalConstraintDef?>
    <end:@R> => {
        let mut children = Vec::new();
        if let Some(subtasks) = subtasks {
            children.push(subtasks);
        }
        if let Some(ordering_constraints) = ordering_constraints {
            children.push(ordering_constraints);
        }
        if let Some(logical_constraints) = logical_constraints {
            children.push(logical_constraints);
        }
        Box::new(Ast::new(AstKind::TaskNetworkDef, children, start, end))
    },
}

pub MethodPreconditionDef: Box<Ast> = {
    <start:@L> ":precondition" <gd:GD> <end:@R> => {
        let mut children = Vec::new();
        children.push(gd);
        Box::new(Ast::new(AstKind::MethodPreconditionDef, children, start, end))
    },
}

pub MethodDef : Box<Ast> = {
    <start:@L>
        "(" ":method" <name:MethodSymbol>
        <parameters:ParameterDef>
        ":task" <task:Task>
        <precondition:MethodPreconditionDef?>
        <task_network:TaskNetworkDef> ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        children.push(task);
        if let Some(precondition) = precondition {
            children.push(precondition);
        }
        children.push(task_network);
        Box::new(Ast::new(AstKind::MethodDef, children, start, end))
    },
}

pub InitialTaskNetwork : Box<Ast> = {
     <start:@L>
        "(" ":htn"
        <parameters:ParameterDef?>
        <task_network:TaskNetworkDef> ")"
     <end:@R> => {
        let mut children = Vec::new();
        if let Some(parameters) = parameters {
            children.push(parameters);
        }
        children.push(task_network);
        Box::new(Ast::new(AstKind::InitialTaskNetwork, children, start, end))
     },
}

pub HDDLRequirement : Box<Ast> = {
    <requirement:Requirement> => requirement,
    <start:@L> ":hierarchy" <end:@R> => {
            Box::new(Ast::new(AstKind::Requirement(Requirement::Hierarchy), Vec::new(), start, end))
    },
    <start:@L> ":method-preconditions" <end:@R> => {
        Box::new(Ast::new(AstKind::Requirement(Requirement::Hierarchy), Vec::new(), start, end))
    },
}

pub HDDLRequireDef : Box<Ast> = {
     <start:@L> "(" ":requirements" <requirements:HDDLRequirement*> ")" <end:@R> => {
        Box::new(Ast::new(AstKind::RequireDef, requirements, start, end))
     },
}

pub HDDLStructureDef : Box<Ast> = {
    <action:ActionDef> =>  action,
    <derived:DerivedDef> => derived,
    <durative_action:DurativeActionDef> => durative_action,
    <task:TaskDef> => task,
    <method:MethodDef> => method,
}

pub HDDLDomain : Box<Ast> = {
    <start:@L>
        "(" "define" "(" "domain" <name:DomainName> ")"
            <require_def:HDDLRequireDef?>
            <types_def:TypesDef?>
            <constants_def:ConstantsDef?>
            <predicates_def:PredicatesDef?>
            <functions_def:FunctionsDef?>
            <structure_def:HDDLStructureDef*>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        if let Some(require_def) = require_def {
            children.push(require_def);
        }
        if let Some(types_def) = types_def {
            children.push(types_def);
        }
        if let Some(constants_def) = constants_def {
            children.push(constants_def);
        }
        if let Some(predicates_def) = predicates_def {
            children.push(predicates_def);
        }
        if let Some(functions_def) = functions_def {
            children.push(functions_def);
        }
        children.extend(structure_def);
        Box::new(Ast::new(AstKind::Domain, children, start, end))
    },
 }

pub HDDLProblem : Box<Ast> = {
    <start:@L>
        "(" "define" "(" "problem" <problem:ProblemName> ")"
        "(" ":domain" <domain:DomainName> ")"
        <require_def:HDDLRequireDef?>
        <objects_def:ObjectsDef?>
        <task_network:InitialTaskNetwork>
        <init:Init>
        <goal:Goal?>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(problem);
        children.push(domain);
        if let Some(require_def) = require_def {
           children.push(require_def);
        }
        if let Some(objects_def) = objects_def {
           children.push(objects_def);
        }
        children.push(init);
        children.push(task_network);
        if let Some(goal) = goal {
            children.push(goal);
        }
        Box::new(Ast::new(AstKind::Problem, children, start, end))
    },
}

pub HDDL : Box<Ast> = {
    <domain:HDDLDomain> => domain,
    <problem:HDDLProblem> => problem,
}
