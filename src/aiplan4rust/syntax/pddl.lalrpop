    <start:@L>
        ":duration" <constraint:DurationConstraint>
        ":condition" <condition:EmptyOr<DAGD>>
        ":effect" <effect:EmptyOr<DAEffect>>
    <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        children.push(condition);
        children.push(effect);
        Box::new(Ast::new(AstKind::DADefBody, children , start, end))
    },
}

pub DurationConstraint : Box<Ast> = {
    <start:@L> "(" "and" <constraints:SimpleDurationConstraint*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(constraints);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
    <start:@L> "(" ")" <end:@R> => {
        Box::new(Ast::new(AstKind::And, Vec::new(), start, end))
    },
    <constraint:SimpleDurationConstraint> => constraint,
}

pub SimpleDurationConstraint : Box<Ast> = {
    <start:@L> "(" <op:DOp> <var:DurationVariable> <value:DValue> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(var);
        children.push(value);
        Box::new(Ast::new(AstKind::FComp(op), children, start, end))
    },
    <start:@L> "at start" <constraints:SimpleDurationConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraints);
        Box::new(Ast::new(AstKind::AtStart, children, start, end))
    },
    <start:@L> "at end" <constraints:SimpleDurationConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraints);
        Box::new(Ast::new(AstKind::AtEnd, children, start, end))
    },
}

pub DurationVariable : Box<Ast> = {
    <start:@L> <var:"?duration"> <end:@R> => {
        Box::new(Ast::new(AstKind::Variable(var.to_string()), Vec::new(), start, end))
    }
}

pub DOp : BinaryComp = {
    ">=" => BinaryComp::GreaterEq,
    "<=" => BinaryComp::LessEq,
    "=" => BinaryComp::Equal,
}

pub DValue : Box<Ast> = {
    <fexp:FExp> => fexp,
}

pub DAGD : Box<Ast> = {
    <pref_timed_gd:PrefTimedGD> => pref_timed_gd,
    <start:@L> "(" "and" <da_gd:DAGD*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(da_gd);
        Box::new(Ast::new(AstKind::And, children, start, end))
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <da_gd:DAGD>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(da_gd);
        Box::new(Ast::new(AstKind::Forall, children, start, end))
    },
}

pub PrefTimedGD : Box<Ast> = {
    <timed_gd:TimedGD> => timed_gd,
    <start:@L> "(" "preference" <pref_name:PrefName?> <timed_gd:TimedGD> ")" <end:@R> => {
        let mut children = Vec::new();
        if let Some(pref_name) = pref_name {
            children.push(pref_name);
        }
        children.push(timed_gd);
        Box::new(Ast::new(AstKind::Preference, children , start, end))
    },
}

