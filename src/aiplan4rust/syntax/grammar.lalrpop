pub Requirement: Result<NodeId, ParseContextError> = {
    <start:@L> ":strips" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::Strips), Vec::new(), start, end),
    <start:@L> ":typing" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::Typing), Vec::new(), start, end),
    <start:@L> ":equality" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::Equality), Vec::new(), start, end),
    <start:@L> ":negative-preconditions" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::NegativePreconditions), Vec::new(), start, end),
    <start:@L> ":disjunctive-preconditions" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::DisjunctivePreconditions), Vec::new(), start, end),
    <start:@L> ":existential-preconditions" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::ExistentialPreconditions), Vec::new(), start, end),
    <start:@L> ":universal-preconditions" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::UniversalPreconditions), Vec::new(), start, end),
    <start:@L> ":quantified-preconditions" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::QuantifiedPreconditions), Vec::new(), start, end),
    <start:@L> ":conditional-effects" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::ConditionalEffects), Vec::new(), start, end),
    <start:@L> ":fluents" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::Fluents), Vec::new(), start, end),
    <start:@L> ":numeric-fluents" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::NumericFluents), Vec::new(), start, end),
    <start:@L> ":object-fluents" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::ObjectFluents), Vec::new(), start, end),
    <start:@L> ":adl" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::Adl), Vec::new(), start, end),
    <start:@L> ":durative-actions" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::DurativeActions), Vec::new(), start, end),
    <start:@L> ":duration-inequalities" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::DurationInequalities), Vec::new(), start, end),
    <start:@L> ":continuous-effects" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::ContinuousEffects), Vec::new(), start, end),
    <start:@L> ":derived-predicates" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::DerivedPredicates), Vec::new(), start, end),
    <start:@L> ":timed-initial-literals" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::TimedInitialLiterals), Vec::new(), start, end),
    <start:@L> ":preferences" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::Preferences), Vec::new(), start, end),
    <start:@L> ":constraints" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::Constraints), Vec::new(), start, end),
    <start:@L> ":action-costs" <end:@R> => context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::ActionCosts), Vec::new(), start, end),
    <start:@L> <error:!> <end:@R> => {
        context.push_error(error);
        context.alloc_node(AstKind::Error, AstContent::None, Vec::new(), start, end)
    },
}

pub RequireDef: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ":requirements" <requirements:Requirement*> ")" <end:@R> => {
        let requirements = requirements.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::RequireDef, AstContent::None, requirements, start, end)
    }
}

pub Type: Result<NodeId, ParseContextError> = {
    <start:@L> <ty:PrimitiveType> <end:@R> => {
        context.alloc_node(AstKind::Type, AstContent::None, vec![ty?], start, end)
    },
    <start:@L> "(" "either" <types:PrimitiveType+> ")" <end:@R> => {
        let types = types.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::Type, AstContent::None, types, start, end)
    }
}

TypedList<T>: Result<NodeId, ParseContextError> = {
    <start:@L> <elements:T*> <end:@R> => {
        let elements = elements.into_iter().collect::<Result<Vec<_>, _>>()?;
        if elements.is_empty() {
            context.alloc_node(AstKind::TypedList, AstContent::None, vec![], start, end)
        } else {
            let typed_item_elt = context.alloc_node(AstKind::TypedItemElements, AstContent::None, elements, start, end);
            let typed_item = context.alloc_node(AstKind::TypedItem, AstContent::None, vec![typed_item_elt?], start, end);
            context.alloc_node(AstKind::TypedList, AstContent::None, vec![typed_item?], start, end)
        }
    },
    <start:@L> <elements:T+> <end_elements:@R> "-" <ty:Type> <end_typed_item:@R> <next:TypedList<T>> <end:@R> => {
        let elements = elements.into_iter().collect::<Result<Vec<_>, _>>()?;
        let typed_item_elt = context.alloc_node(AstKind::TypedItemElements, AstContent::None, elements, start, end_elements);
        let typed_item = context.alloc_node(AstKind::TypedItem, AstContent::None, vec![typed_item_elt?, ty?], start, end_typed_item);
        let typed_list = context.alloc_node(AstKind::TypedList, AstContent::None, vec![typed_item?], start, end);
        context.merge_typed_list(typed_list?, next?)
    }
}

pub TypesDef: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ":types" <types:TypedList<PrimitiveType>> ")" <end:@R> => {
        context.alloc_node(AstKind::TypesDef, AstContent::None, vec![types?], start, end)
    }
}

