    <start:@L> "(" "and" <da_effect:DAEffect*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, da_effect, start, end, None)
    },
    <timed_effect:TimedEffect> => timed_effect,
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <da_effect:DAEffect>
        ")"
    <end:@R> => {
        context.new_node(AstKind::Forall, AstContent::None, vec![variables, da_effect], start, end, None)
    },
    <start:@L> "(" "when" <da_gd:DAGD> <time_effect:TimedEffect> ")" <end:@R> => {
        context.new_node(AstKind::When, AstContent::None, vec![da_gd, time_effect], start, end, None)
    },
}

pub TimedEffect: NodeId = {
    <start:@L> "(" "at start" <con_effect:CondEffect> ")" <end:@R> => {
        context.new_node(AstKind::AtStart, AstContent::None, vec![con_effect], start, end, None)
    },
    <start:@L> "(" "at end" <con_effect:CondEffect> ")" <end:@R> => {
        context.new_node(AstKind::AtEnd, AstContent::None, vec![con_effect], start, end, None)
    },
    <start:@L> "(" <op:AssignOpT> <fhead:FHead> <fexpt:FExpT> ")" <end:@R> => {
        context.new_node(AstKind::Assign, op, vec![fhead, fexpt], start, end, None)
    },
}

