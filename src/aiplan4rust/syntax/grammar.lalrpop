pub Requirement: NodeId = {
    <start:@L> ":strips" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::Strips), Vec::new(), start, end, None),
    <start:@L> ":typing" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::Typing), Vec::new(), start, end, None),
    <start:@L> ":equality" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::Equality), Vec::new(), start, end, None),
    <start:@L> ":negative-preconditions" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::NegativePreconditions), Vec::new(), start, end, None),
    <start:@L> ":disjunctive-preconditions" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::DisjunctivePreconditions), Vec::new(), start, end, None),
    <start:@L> ":existential-preconditions" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::ExistentialPreconditions), Vec::new(), start, end, None),
    <start:@L> ":universal-preconditions" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::UniversalPreconditions), Vec::new(), start, end, None),
    <start:@L> ":quantified-preconditions" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::QuantifiedPreconditions), Vec::new(), start, end, None),
    <start:@L> ":conditional-effects" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::ConditionalEffects), Vec::new(), start, end, None),
    <start:@L> ":fluents" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::Fluents), Vec::new(), start, end, None),
    <start:@L> ":numeric-fluents" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::NumericFluents), Vec::new(), start, end, None),
    <start:@L> ":object-fluents" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::ObjectFluents), Vec::new(), start, end, None),
    <start:@L> ":adl" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::Adl), Vec::new(), start, end, None),
    <start:@L> ":durative-actions" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::DurativeActions), Vec::new(), start, end, None),
    <start:@L> ":duration-inequalities" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::DurationInequalities), Vec::new(), start, end, None),
    <start:@L> ":continuous-effects" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::ContinuousEffects), Vec::new(), start, end, None),
    <start:@L> ":derived-predicates" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::DerivedPredicates), Vec::new(), start, end, None),
    <start:@L> ":timed-initial-literals" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::TimedInitialLiterals), Vec::new(), start, end, None),
    <start:@L> ":preferences" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::Preferences), Vec::new(), start, end, None),
    <start:@L> ":constraints" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::Constraints), Vec::new(), start, end, None),
    <start:@L> ":action-costs" <end:@R> => context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::ActionCosts), Vec::new(), start, end, None),
    <start:@L> <error:!> <end:@R> => {
        context.push(error);
        context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None)
    },
}

pub RequireDef: NodeId = {
    <start:@L> "(" ":requirements" <requirements:Requirement*> ")" <end:@R> => {
        context.new_node(AstKind::RequireDef, AstContent::None, requirements, start, end, None)
    }
}

pub Type: NodeId = {
    <start:@L> <ty:PrimitiveType> <end:@R> => {
        context.new_node(AstKind::Type, AstContent::None, vec![ty], start, end, None)
    },
    <start:@L> "(" "either" <types:PrimitiveType+> ")" <end:@R> => {
        context.new_node(AstKind::Type, AstContent::None, types, start, end, None)
    }
}

TypedList<T>: NodeId= {
    <start:@L> <elements:T*> <end:@R> => {
        let typed_item_elt = context.new_node(AstKind::TypedItemElements, AstContent::None, elements, start, end, None);
        let typed_item = context.new_node(AstKind::TypedItem, AstContent::None, vec![typed_item_elt], start, end, None);
        context.new_node(AstKind::TypedList, AstContent::None, vec![typed_item], start, end, None)
    },
    <start:@L> <elements:T+> <end_elements:@R> "-" <ty:Type> <end_typed_item:@R> <mut next:TypedList<T>> <end:@R> => {
        let typed_item_elt = context.new_node(AstKind::TypedItemElements, AstContent::None, elements, start, end_elements, None);
        let typed_item = context.new_node(AstKind::TypedItem, AstContent::None, vec![typed_item_elt, ty], start, end_typed_item, None);
        let mut typed_list = context.new_node(AstKind::TypedList, AstContent::None, vec![typed_item], start, end, None);
        context.merge_typed_list(typed_list, next);
        typed_list
    }
}

pub TypesDef: NodeId = {
    <start:@L> "(" ":types" <types:TypedList<PrimitiveType>> ")" <end:@R> => {
        context.new_node(AstKind::TypesDef, AstContent::None, vec![types], start, end, None)
    }
}

pub ConstantsDef: NodeId = {
    <start:@L> "(" ":constants" <constants:TypedList<Constant>> ")" <end:@R> => {
        context.new_node(AstKind::ConstantsDef, AstContent::None, vec![constants], start, end, None)
    }
}

pub PredicatesDef: NodeId = {
    <start:@L> "(" ":predicates" <predicates:AtomicFormulaSkeleton+> ")" <end:@R> => {
        context.new_node(AstKind::PredicatesDef, AstContent::None, predicates, start, end, None)
    }
}

pub AtomicFormulaSkeleton: NodeId = {
    <start:@L> "(" <predicate:Predicate> <arguments:TypedList<Variable>> ")" <end:@R> => {
        context.new_node(AstKind::AtomicFormulaSkeleton, AstContent::None, vec![predicate, arguments], start, end, None)
    }
}

pub FunctionsDef: NodeId = {
    <start:@L> "(" ":functions" <functions:TypedList<AtomicFunctionSkeleton>> ")" <end:@R> => {
        context.new_node(AstKind::FunctionsDef, AstContent::None, vec![functions], start, end, None)
    }
}

pub AtomicFunctionSkeleton: NodeId = {
    <start:@L> "(" <functor:FunctionSymbol> <arguments:TypedList<Variable>> ")" <end:@R> => {
        context.new_node(AstKind::AtomicFunctionSkeleton, AstContent::None, vec![functor, arguments], start, end, None)
    }
}

pub StructureDef: NodeId = {
    <action:ActionDef> => action,
    <derived:DerivedDef> => derived,
    <durative_action:DurativeActionDef> => durative_action,
}

pub ActionDef: NodeId = {
    <start:@L>
        "(" ":action"
            <name:ActionSymbol>
            <parameters:ParameterDef>
            <body:ActionDefBody>
        ")"
    <end:@R> => {
        context.new_node(AstKind::ActionDef, AstContent::None, vec![name, parameters, body], start, end, None)
    }
}

pub ParameterDef: NodeId = {
    <start:@L>
       ":parameters" "(" <parameters:TypedList<Variable>> ")"
    <end:@R> => {
        context.new_node(AstKind::ParametersDef, AstContent::None, vec![parameters], start, end, None)
    }
}

pub ActionDefBody: NodeId = {
    <start:@L> <precondition:PreconditionDef?> <effect:EffectDef?> <end:@R> => {
        let mut children = Vec::new();
        if let Some(pre) = precondition {
            children.push(pre);
        }
        if let Some(eff) = effect {
            children.push(eff);
        }
        context.new_node(AstKind::ActionDefBody, AstContent::None, children, start, end, None)
    }
}

pub PreconditionDef: NodeId = {
    <start:@L> ":precondition" <precondition:EmptyOr<PreGD>> <end:@R> => {
        context.new_node(AstKind::PreconditionDef, AstContent::None, vec![precondition], start, end, None)
    }
}

pub EffectDef: NodeId = {
    <start:@L> ":effect" <effect:EmptyAnd<Effect>> <end:@R> => {
        context.new_node(AstKind::EffectDef, AstContent::None, vec![effect], start, end, None)
    }
}

EmptyOr<T>: NodeId = {
    <start:@L> "(" ")" <end:@R> => {
        context.new_node(AstKind::Or, AstContent::None, Vec::new(), start, end, None)
    },
    <start:@L> <element:T> <end:@R> => element,
}

EmptyAnd<T>: NodeId = {
    <start:@L> "(" ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, Vec::new(), start, end, None)
    },
    <start:@L> <element:T> <end:@R> => element,
}

pub PreGD: NodeId = {
    <start:@L> <pref_gd:PrefGD> <end:@R> => pref_gd,
    <atom:AtomicFormula<Term>> => atom,
    <start:@L> "(" "and" <pre_gd:PreGD*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, pre_gd, start, end, None)
    },
    <start:@L> "(" "or" <gd:GD*> ")" <end:@R> => {
        context.new_node(AstKind::Or, AstContent::None, gd, start, end, None)
    },
    <start:@L> "(" "not" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::Not, AstContent::None, vec![gd], start, end, None)
    },
    <start:@L> "(" "imply" <antecedent:GD> <consequence:GD> ")" <end:@R> => {
        context.new_node(AstKind::Imply, AstContent::None, vec![antecedent, consequence], start, end, None)
    },
    <start:@L>
        "(" "exists"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        context.new_node(AstKind::Exists, AstContent::None, vec![variables, gd], start, end, None)
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <pre_gd:PreGD>
        ")"
    <end:@R> => {
        context.new_node(AstKind::Forall, AstContent::None, vec![variables, pre_gd], start, end, None)
    },
    <fcomp:FComp> => fcomp,
}

pub PrefGD: NodeId = {
    <start:@L> "(" "preference" <pref_name:PrefName?> <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        if let Some(pref_name) = pref_name {
            children.push(pref_name);
        }
        children.push(gd);
        context.new_node(AstKind::Preference, AstContent::None, children, start, end, None)
    },
}

pub GD: NodeId = {
    <atom:AtomicFormula<Term>> => atom,
    <start:@L> "(" "and" <gd:GD*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, gd, start, end, None)
    },
    <start:@L> "(" "or" <gd:GD*> ")" <end:@R> => {
        context.new_node(AstKind::Or, AstContent::None, gd, start, end, None)
    },
    <start:@L> "(" "not" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::Not, AstContent::None, vec![gd], start, end, None)
    },
    <start:@L> "(" "imply" <antecedent:GD> <consequence:GD> ")" <end:@R> => {
        context.new_node(AstKind::Imply, AstContent::None, vec![antecedent, consequence], start, end, None)
    },
    <start:@L>
        "(" "exists"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        context.new_node(AstKind::Exists, AstContent::None, vec![variables, gd], start, end, None)
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        context.new_node(AstKind::Forall, AstContent::None, vec![variables, gd], start, end, None)
    },
    <fcomp:FComp> => fcomp,
}

pub Effect: NodeId = {
    <start:@L> "(" "and" <effects:CEffect*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, effects, start, end, None)
    },
    <effect:CEffect> => effect,
}

pub CEffect: NodeId = {
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <effect:Effect>
        ")"
    <end:@R> => {
        context.new_node(AstKind::Forall, AstContent::None, vec![variables, effect], start, end, None)
    },
    <start:@L> "(" "when" <gd:GD> <effect:CondEffect> ")" <end:@R> => {
        context.new_node(AstKind::When, AstContent::None, vec![gd, effect], start, end, None)
    },
    <effect:PEffect> => effect,
}

pub PEffect: NodeId = {
    <literal:Literal<Term>> => literal,
    <start:@L> "(" <op:AssignOp> <fhead:FHead> <fexp:_FExp> ")" <end:@R> => {
        context.new_node(AstKind::Assign, op, vec![fhead, fexp], start, end, None)
    },
}

pub CondEffect: NodeId = {
    <start:@L> "(" "and" <effects:PEffect*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, effects, start, end, None)
    },
    <effect:PEffect> => effect,
}

pub Term: NodeId = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            context.new_node(AstKind::Constant, AstContent::Ident(context.intern(name)), Vec::new(), start, end, None)
        } else {
            context.new_node(AstKind::Variable, AstContent::Ident(context.intern(name)), Vec::new(), start, end, None)
        }
    },
    <duration:DurationVariable> => duration,
    <function:FunctionTerm> => function,
}

pub FunctionTerm: NodeId = {
    <function_term:_FunctionTerm<Term>> => function_term,
}

_FunctionTerm<T>: NodeId = {
    <start:@L> "(" <function_symbol:FunctionSymbol> <arguments:T*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(function_symbol);
        children.extend(arguments);
        context.new_node(AstKind::FunctionTerm, AstContent::None, children, start, end, None)
    }
}

pub FComp: NodeId = {
    <start:@L> "(" <comparator:BinaryComp> <arg1:_FExp> <arg2:_FExp> ")" <end:@R> => {
        context.new_node(AstKind::FComp, comparator, vec![arg1, arg2], start, end, None)
    }
}

pub BinaryComp : AstContent = {
    ">" =>AstContent::BinaryComp(BinaryComp::Greater),
    "<" =>AstContent::BinaryComp(BinaryComp::Less),
    "=" =>AstContent::BinaryComp(BinaryComp::Equal),
    ">=" =>AstContent::BinaryComp(BinaryComp::GreaterEq),
    "<=" =>AstContent::BinaryComp(BinaryComp::LessEq),
}

pub AssignOp : AstContent = {
    "assign" =>AstContent::AssignOp(AssignOp::Assign),
    "scale-up" =>AstContent::AssignOp(AssignOp::ScaleUp),
    "scale-down" =>AstContent::AssignOp(AssignOp::ScaleDown),
    "increase" =>AstContent::AssignOp(AssignOp::Increase),
    "decrease" =>AstContent::AssignOp(AssignOp::Decrease),
}

pub ArithmeticOp : AstContent = {
    "-" =>AstContent::ArithmeticOp(ArithmeticOp::Sub),
    "+" =>AstContent::ArithmeticOp(ArithmeticOp::Add),
    "/" =>AstContent::ArithmeticOp(ArithmeticOp::Div),
    "*" =>AstContent::ArithmeticOp(ArithmeticOp::Mul),
}

Literal<T>: NodeId = {
    <atom:AtomicFormula<T>> => atom,
    <start:@L> "(" "not" <atom:AtomicFormula<T>> ")" <end:@R> => {
        context.new_node(AstKind::Not, AstContent::None, vec![atom], start, end, None)
    }
}

AtomicFormula<T>: NodeId = {
    <start:@L> "(" <predicate:Predicate> <terms:T*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(predicate);
        children.extend(terms);
        context.new_node(AstKind::AtomicFormula, AstContent::None, children, start, end, None)
    }
}

_FExp: NodeId = {
    <term:Term> => term,
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:_FExp> <arg2:_FExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Sub), children, start, end, None)
    },
    <start:@L> "(" "/" <arg1:_FExp> <arg2:_FExp> ")" <end:@R> => {
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Div), vec![arg1, arg2], start, end, None)
    },
    <start:@L> "(" "+" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Add), children, start, end, None)
    },
    <start:@L> "(" "*" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Mul), children, start, end, None)
    },
}

pub FExp: NodeId = {
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:FExp> <arg2:FExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Sub), children, start, end, None)
    },
    <start:@L> "(" "/" <arg1:FExp> <arg2:FExp> ")" <end:@R> => {
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Div), vec![arg1, arg2], start, end, None)
    },
    <start:@L> "(" "+" <arg1:FExp> <next_args:FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Add), children, start, end, None)
    },
    <start:@L> "(" "*" <arg1:FExp> <next_args:FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Mul), children, start, end, None)
    },
    <fhead:FHead> => fhead,
}

pub FExpDA: NodeId = {
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:FExpDA> <arg2:FExpDA?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Sub), children, start, end, None)
    },
    <start:@L> "(" "/" <arg1:FExpDA> <arg2:FExpDA> ")" <end:@R> => {
        context.new_node(
            AstKind::Operation,
            AstContent::ArithmeticOp(ArithmeticOp::Div),
            vec![arg1, arg2],
            start,
            end,
            None,
        )
    },
    <start:@L> "(" "+" <arg1:FExpDA> <next_args:FExpDA+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Add), children, start, end, None)
    },
    <start:@L> "(" "*" <arg1:FExpDA> <next_args:FExpDA+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Mul), children, start, end, None)
    },
    <fhead:FHead> => fhead, // Add to accept the good syntax
    //<fexp:FExp> => fexp, // Remove for conflict
    <duration:DurationVariable> => duration,
}

pub FHead: NodeId = {
    <function:FunctionTerm> => function,
    <start:@L> <symbol:FunctionSymbol> <end:@R> => {
        context.new_node(AstKind::FunctionTerm, AstContent::None, vec![symbol], start, end, None)
    }
}

pub Constraints: NodeId = {
    <start:@L> "(" ":constraints" <con_gd:ConGD> ")" <end:@R> => {
        context.new_node(AstKind::Constraints, AstContent::None, vec![con_gd], start, end, None)
    }
}

pub ConGD: NodeId = {
    <start:@L> "(" "and" <con_gd:ConGD*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, con_gd, start, end, None)
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")"
            <end_var:@R> <con_gd:ConGD>
        ")"
    <end:@R> => {
        context.new_node(AstKind::Forall, AstContent::None, vec![variables, con_gd], start, end, None)
    },
    <start:@L> "(" "at end" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::AtEnd, AstContent::None, vec![gd], start, end, None)
    },
    <start:@L> "(" "always" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::Always, AstContent::None, vec![gd], start, end, None)
    },
    <start:@L> "(" "sometime" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::Sometime, AstContent::None, vec![gd], start, end, None)
    },
    <start:@L> "(" "within" <number:Number> <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::Within, AstContent::None, vec![number, gd], start, end, None)
    },
    <start:@L> "(" "at-most-once" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::AtMostOnce, AstContent::None, vec![gd], start, end, None)
    },
    <start:@L> "(" "sometime-after" <gd1:GD> <gd2:GD> ")" <end:@R> => {
        context.new_node(AstKind::SometimeAfter, AstContent::None, vec![gd1, gd2], start, end, None)
    },
    <start:@L> "(" "sometime-before" <gd1:GD> <gd2:GD> ")" <end:@R> => {
        context.new_node(AstKind::SometimeBefore, AstContent::None, vec![gd1, gd2], start, end, None)
    },
    <start:@L> "(" "always-within" <number:Number> <gd1:GD> <gd2:GD> ")" <end:@R> => {
        context.new_node(AstKind::AlwaysWithin, AstContent::None, vec![number, gd1, gd2], start, end, None)
    },
    <start:@L> "(" "hold-during" <lower:Number> <upper:Number> <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::HoldDuring, AstContent::None, vec![lower, upper, gd], start, end, None)
    },
    <start:@L> "(" "hold-after" <number:Number> <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::HoldAfter, AstContent::None, vec![number, gd], start, end, None)
    },
}

