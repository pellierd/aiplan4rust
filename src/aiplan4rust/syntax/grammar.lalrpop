}

pub AtomicFormulaSkeleton: Result<NodeId, ParseContextError> = {
    <start:@L> "(" <predicate:Predicate> <arguments:TypedList<Variable>> ")" <end:@R> => {
        context.alloc_node(AstKind::AtomicFormulaSkeleton, AstContent::None, vec![predicate?, arguments?], start, end)
    }
}

