pub PrefName: NodeId = {
    <start:@L> <name:Name> <end:@R> => match name {
        Ok(name) => context.new_node(AstKind::PrefName, name, Vec::new(), start, end, None),
        Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None),
