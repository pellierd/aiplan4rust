pub DAEffect : Box<IntAstNode> = {
    <start:@L>  "(" "and" <da_effect:DAEffect*> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.extend(da_effect);
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, children, start, end))
    },
    <timed_effect:TimedEffect>  => timed_effect,
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <da_effect:DAEffect>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(da_effect);
        Box::new(IntAstNode::new(IntAstKind::Forall, AstContent::None, children, start, end))
    },
    <start:@L> "(" "when" <da_gd:DAGD> <time_effect:TimedEffect> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(da_gd);
        children.push(time_effect);
        Box::new(IntAstNode::new(IntAstKind::When, AstContent::None, children, start, end))
    },
}

pub TimedEffect : Box<IntAstNode> = {
    <start:@L> "(" "at start" <con_effect:CondEffect> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(con_effect);
        Box::new(IntAstNode::new(IntAstKind::AtStart, AstContent::None, children, start, end))
    },
    <start:@L> "(" "at end" <con_effect:CondEffect> ")" <end:@R> => {
         let mut children = Vec::new();
         children.push(con_effect);
         Box::new(IntAstNode::new(IntAstKind::AtEnd, AstContent::None, children, start, end))
    },
    <start:@L> "(" <op:AssignOpT> <fhead:FHead> <fexpt:FExpT> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(fhead);
        children.push(fexpt);
        Box::new(IntAstNode::new(IntAstKind::Assign, op, children, start, end))
    },
}

pub FAssignDA : Box<IntAstNode> = {
    <start:@L> "(" <op:AssignOp> <fhead:FHead> <fexpda:FExpDA> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(fhead);
        children.push(fexpda);
        Box::new(IntAstNode::new(IntAstKind::Assign, op, children, start, end))
    },
}

pub AssignOpT :AstContent = {
    "increase" =>AstContent::Assign(AssignOp::Increase),
    "decrease" =>AstContent::Assign(AssignOp::Decrease),
}

pub FExpT : Box<IntAstNode> = {
    <start:@L> "(" "*" <fexp:FExp> <var:ContinusVariable> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(fexp);
        children.push(var);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Mul), children, start, end))
    },
    <start:@L> "(" "*" <var:ContinusVariable> <fexp:FExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(var);
        children.push(fexp);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Mul), children, start, end))
    },
    <var:ContinusVariable> => var,
}

pub ContinusVariable : Box<IntAstNode> = {
    <start:@L> <var:"#t"> <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Variable, AstContent::Ident(var.to_string()), Vec::new(), start, end))
    }
}

pub Domain : Box<IntAstNode> = {
    <start:@L>
        "(" "define" "(" "domain" <name:DomainName> ")"
            <require_def:RequireDef?>
            <types_def:TypesDef?>
            <constants_def:ConstantsDef?>
            <predicates_def:PredicatesDef?>
            <functions_def:FunctionsDef?>
            <constraints:Constraints?>
            <structure_def:StructureDef*>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        if let Some(require_def) = require_def {
            children.push(require_def);
        }
        if let Some(types_def) = types_def {
            children.push(types_def);
        }
        if let Some(constants_def) = constants_def {
            children.push(constants_def);
        }
        if let Some(predicates_def) = predicates_def {
            children.push(predicates_def);
        }
        if let Some(functions_def) = functions_def {
            children.push(functions_def);
        }
        if let Some(constraints) = constraints {
            children.push(constraints);
        }

        children.extend(structure_def);
        Box::new(IntAstNode::new(IntAstKind::Domain, AstContent::None, children, start, end))
    },
 }

pub ObjectsDef : Box<IntAstNode> = {
    <start:@L> "(" ":objects" <objects:TypedList<Constant>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(objects);
        Box::new(IntAstNode::new(IntAstKind::ObjectsDef, AstContent::None, children , start, end))
    },
}

pub BasicFunctionTerm : Box<IntAstNode> = {
    <function:FunctionTerm> => function,
    <symbol:FunctionSymbol> => symbol,
}

pub InitEl : Box<IntAstNode> = {
    <literal:Literal<Constant>> => literal,
    <start:@L> "(" <number:Number> <literal:Literal<Constant>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(number);
        children.push(literal);
        Box::new(IntAstNode::new(IntAstKind::TimedInitialLiteral, AstContent::None, children , start, end))
    },
    <start:@L> "(" "=" <function:BasicFunctionTerm> <number:Number> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.push(function);
        children.push(number);
        Box::new(IntAstNode::new(IntAstKind::FComp, AstContent::Comparison(BinaryComp::Equal), children , start, end))
    },
    <start:@L> "(" "=" <function:BasicFunctionTerm> <constant:Constant> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.push(function);
        children.push(constant);
        Box::new(IntAstNode::new(IntAstKind::FComp, AstContent::Comparison(BinaryComp::Equal), children , start, end))
    },
}

pub Init : Box<IntAstNode> = {
    <start:@L> "(" ":init" <init_els:InitEl*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(init_els);
        Box::new(IntAstNode::new(IntAstKind::Init, AstContent::None, children , start, end))
    },
}

pub Goal : Box<IntAstNode> = {
     <start:@L> "(" ":goal" <pre_gd:PreGD> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(pre_gd);
        Box::new(IntAstNode::new(IntAstKind::Goal, AstContent::None, children , start, end))
     },
}

pub Optimization :AstContent = {
    "minimize" => AstContent::Optimization(Optimization::Minimize),
    "maximize" => AstContent::Optimization(Optimization::Maximize),
}

pub MetricFExp : Box<IntAstNode> = {
    <number:Number> => number,
    <function:_FunctionTerm<Constant>> => function,
    <start:@L> <symbol:FunctionSymbol> <end:@R> => {
        let mut children = Vec::new();
        children.push(symbol);
        Box::new(IntAstNode::new(IntAstKind::FunctionTerm, AstContent::None, children, start, end))
    },
    <start:@L> "(" "-" <arg1:MetricFExp> <arg2:MetricFExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Sub), children, start, end))
    },
    <start:@L> "(" "/" <arg1:MetricFExp> <arg2:MetricFExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.push(arg2);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Div), children, start, end))
    },
    <start:@L> "(" "+" <arg1:MetricFExp> <next_args:MetricFExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Add), children, start, end))
    },
    <start:@L> "(" "*" <arg1:MetricFExp> <next_args:MetricFExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Mul), children, start, end))
    },
    //<start:@L> "total-time" <end:@R> => {
    //    Box::new(IntAstNode::new(IntAstKind::TotalTime, Vec::new(), start, end))
    //},
    <start:@L> "(" "is-violated" <pref:PrefName> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(pref);
        Box::new(IntAstNode::new(IntAstKind::IsViolated, AstContent::None, Vec::new(), start, end))
    },
}

pub MetricSpec : Box<IntAstNode> = {
    <start:@L> "(" ":metric" <op:Optimization> <fexp:MetricFExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(fexp);
        Box::new(IntAstNode::new(IntAstKind::Metric, op, children, start, end))
    },
}

pub Length : Box<IntAstNode> = {
    <start:@L>
        "(" ":length"
            <start_serial:@L> "(" ":serial" <serial_value:"number"?> ")" <end_serial:@R>
            <start_parallel:@L> "(" ":parallel" <parallel_value:"number"?> ")" <end_parallel:@R>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        if let Some(serial_value) = serial_value {
            children.push(Box::new(IntAstNode::new(IntAstKind::Serial, AstContent::Float(OrderedFloat(serial_value)), Vec::new(), start_serial, end_serial)));
        }
        if let Some(parallel_value) = parallel_value {
            children.push(Box::new(IntAstNode::new(IntAstKind::Parallel, AstContent::Float(OrderedFloat(parallel_value)), Vec::new(), start_parallel, end_parallel)));
        }
        Box::new(IntAstNode::new(IntAstKind::Length, AstContent::None, children, start, end))
    },
}

pub Problem : Box<IntAstNode> = {
    <start:@L>
        "(" "define" "(" "problem" <problem:ProblemName> ")"
        "(" ":domain" <domain:DomainName> ")"
        <require_def:RequireDef?>
        <objects_def:ObjectsDef?>
        <init:Init>
        <goal:Goal>
        <constraints:Constraints?>
        <metric_spec:MetricSpec?>
        <length_spec:Length?>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(problem);
        children.push(domain);
        if let Some(require_def) = require_def {
           children.push(require_def);
        }
        if let Some(objects_def) = objects_def {
           children.push(objects_def);
        }
        children.push(init);
        children.push(goal);
        if let Some(constraints) = constraints {
            children.push(constraints);
        }
        if let Some(metric_spec) = metric_spec {
            children.push(metric_spec);
        }
        if let Some(length_spec) = length_spec {
            children.push(length_spec);
        }
        Box::new(IntAstNode::new(IntAstKind::Problem, AstContent::None, children, start, end))
    },
}

pub PDDL : Box<IntAstNode> = {
    <domain:Domain> => domain,
    <problem:Problem> => problem,
}

///////////////////////////////////////////////////////////////////////////////////////////////
// HDDL Dialect
///////////////////////////////////////////////////////////////////////////////////////////////

pub TaskSymbol : Box<IntAstNode> = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => Box::new(IntAstNode::new(IntAstKind::TaskSymbol, name, Vec::new(), start, end)),
            Err(_) => Box::new(IntAstNode::new(IntAstKind::Error, AstContent::None, Vec::new(), start, end)),
        }
    },
}

pub TaskDef : Box<IntAstNode> = {
    <start:@L> "(" ":task" <symbol:TaskSymbol> <parameters:ParameterDef> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(symbol);
        children.push(parameters);
        Box::new(IntAstNode::new(IntAstKind::TaskDef, AstContent::None, children, start, end))
    },
}

pub MethodSymbol : Box<IntAstNode> = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => Box::new(IntAstNode::new(IntAstKind::MethodSymbol, name, Vec::new(), start, end)),
            Err(_) => Box::new(IntAstNode::new(IntAstKind::Error, AstContent::None, Vec::new(), start, end)),
        }
    },
}

pub TaskID : Box<IntAstNode> = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => Box::new(IntAstNode::new(IntAstKind::TaskID, name, Vec::new(), start, end)),
            Err(_) => Box::new(IntAstNode::new(IntAstKind::Error, AstContent::None, Vec::new(), start, end)),
        }
    },
}

pub TaskTerm: Box<IntAstNode> = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            Box::new(IntAstNode::new(IntAstKind::Constant, AstContent::Ident(name), Vec::new(), start, end))
        } else {
            Box::new(IntAstNode::new(IntAstKind::Variable, AstContent::Ident(name), Vec::new(), start, end))
        }
    },
}

pub Task : Box<IntAstNode> = {
    <start:@L> "(" <symbol:TaskSymbol> <terms:TaskTerm*> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.push(symbol);
        children.extend(terms);
        Box::new(IntAstNode::new(IntAstKind::Task, AstContent::None, children, start, end))
    },
}

pub Subtask: Box<IntAstNode> = {
     "(" <start_name:@L> <name:Name> <end_name:@R> <rest:SubtaskRest>  <end_rest:@R> => {
        match name {
            Ok(name_value) => {
                match rest.first().map(|node| node.kind()) {
                    Some(IntAstKind::TaskSymbol) => {
                        let mut children = Vec::new();
                        let task_id = Box::new(IntAstNode::new(IntAstKind::TaskID, name_value, Vec::new(), start_name, end_name));
                        children.push(task_id);
                        let task = Box::new(IntAstNode::new(IntAstKind::Task, AstContent::None, rest, end_name, end_rest));
                        children.push(task);
                        Box::new(IntAstNode::new(IntAstKind::TaggedTask, AstContent::None, children, start_name, end_rest))
                    },
                    Some(IntAstKind::Constant) | Some(IntAstKind::Variable) => {
                        let mut children = Vec::new();
                        let task_symbol = Box::new(IntAstNode::new(IntAstKind::TaskSymbol, name_value, Vec::new(), start_name, end_name));
                        children.push(task_symbol);
                        children.extend(rest);
                        Box::new(IntAstNode::new(IntAstKind::Task, AstContent::None, children, start_name, end_rest))
                    },
                    _ => {
                        Box::new(IntAstNode::new(IntAstKind::Error, AstContent::None, Vec::new(), start_name, end_name))
                    }
                }
            },
            Err(_) => {
                Box::new(IntAstNode::new(IntAstKind::Error, AstContent::None, Vec::new(), start_name, end_rest))
            }
        }
    },
}

SubtaskRest : Vec<Box<IntAstNode>> = {
    <start:@L> "(" <task_symbol:TaskSymbol> <terms:TaskTerm*> ")" ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(task_symbol);
        children.extend(terms);
        children
    },
    <start:@L> <terms:TaskTerm*> ")" <end:@R> => terms,
}

pub SubtaskDef : Box<IntAstNode> = {
    <start:@L> <subtask:Subtask> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtask);
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, children, start, end))
    },
    <start:@L> "(" ")" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, Vec::new(), start, end))
    },
    <start:@L> "(" "and" <subtasks:Subtask*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(subtasks);
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, children, start, end))
    },
}

pub TaskNetworkdSubtaskDef: Box<IntAstNode> = {
    <start:@L> ":ordered-tasks" <subtasks:SubtaskDef> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtasks);
        Box::new(IntAstNode::new(IntAstKind::OrderedSubtaskDef, AstContent::None, children, start, end))
    },
    <start:@L> ":ordered-subtasks" <subtasks:SubtaskDef> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtasks);
        Box::new(IntAstNode::new(IntAstKind::OrderedSubtaskDef, AstContent::None, children, start, end))
    },
    <start:@L> ":tasks" <subtasks:SubtaskDef> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtasks);
        Box::new(IntAstNode::new(IntAstKind::PartiallyOrderedSubtaskDef, AstContent::None, children, start, end))
    },
    <start:@L> ":subtasks" <subtasks:SubtaskDef> <end:@R> => {
        let mut children = Vec::new();
        children.push(subtasks);
        Box::new(IntAstNode::new(IntAstKind::PartiallyOrderedSubtaskDef, AstContent::None, children, start, end))
    },
}

pub SimpleTaskOrderingConstraint : Box<IntAstNode> = {
    <start:@L> "(" "<" <t1:TaskID> <t2:TaskID> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(t1);
        children.push(t2);
        Box::new(IntAstNode::new(IntAstKind::TaskOrderingConstraint, AstContent::Comparison(BinaryComp::Less), children, start, end))
    },
}

pub TaskOrderingConstraint : Box<IntAstNode> = {
    <start:@L> <constraint:SimpleTaskOrderingConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, children, start, end))
    },
    <start:@L> "(" ")" <end:@R> => {
            Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, Vec::new(), start, end))
    },
    <start:@L> "(" "and" <constraints:SimpleTaskOrderingConstraint*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(constraints);
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, children, start, end))
    },
}

pub TaskNetworkOrderingConstraintDef : Box<IntAstNode> = {
    <start:@L> ":ordering" <constraints:TaskOrderingConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraints);
        Box::new(IntAstNode::new(IntAstKind::TaskOrderingConstraintDef, AstContent::None, children, start, end))
    },
     <start:@L> ":order" <constraints:TaskOrderingConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraints);
        Box::new(IntAstNode::new(IntAstKind::TaskOrderingConstraintDef, AstContent::None, children, start, end))
    },
}

pub SimpleTaskLogicalConstraint : Box<IntAstNode> = {
    <start:@L>
        "(" "=" <t1:Term> <t2:Term> ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(t1);
        children.push(t2);
        Box::new(IntAstNode::new(IntAstKind::FComp, AstContent::Comparison(BinaryComp::Equal), children, start, end))
    },
    <start:@L> "(" "not" <constraint:SimpleTaskLogicalConstraint> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        Box::new(IntAstNode::new(IntAstKind::Not, AstContent::None, children, start, end))
    },
}

pub TaskLogicalConstraint : Box<IntAstNode> = {
    <start:@L> "(" ")" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, Vec::new(), start, end))
    },
    <start:@L> <constraint:SimpleTaskLogicalConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, children, start, end))
    },
    <start:@L> "(" "and" <constraints:SimpleTaskLogicalConstraint*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(constraints);
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, children, start, end))
    },
}

pub TaskNetworkLogicalConstraintDef : Box<IntAstNode> = {
    <start:@L> ":constraints" <constraint:TaskLogicalConstraint> <end:@R> => {
        let mut children = Vec::new();
        children.push(constraint);
        Box::new(IntAstNode::new(IntAstKind::TaskLogicalConstraintDef, AstContent::None, children, start, end))
    },
}

pub TaskNetworkDef : Box<IntAstNode> = {
    <start:@L>
        <subtasks:TaskNetworkdSubtaskDef?>
        <ordering_constraints:TaskNetworkOrderingConstraintDef?>
        <logical_constraints:TaskNetworkLogicalConstraintDef?>
    <end:@R> => {
        let mut children = Vec::new();
        if let Some(subtasks) = subtasks {
            children.push(subtasks);
        }
        if let Some(ordering_constraints) = ordering_constraints {
            children.push(ordering_constraints);
        }
        if let Some(logical_constraints) = logical_constraints {
            children.push(logical_constraints);
        }
        Box::new(IntAstNode::new(IntAstKind::TaskNetworkDef, AstContent::None, children, start, end))
    },
}

pub MethodPreconditionDef: Box<IntAstNode> = {
    <start:@L> ":precondition" <gd:EmptyOr<GD>> <end:@R> => {
        let mut children = Vec::new();
        children.push(gd);
        Box::new(IntAstNode::new(IntAstKind::MethodPreconditionDef, AstContent::None, children, start, end))
    },
}

pub MethodDef : Box<IntAstNode> = {
    <start:@L>
        "("":method"
            <name:MethodSymbol>
            <parameters:ParameterDef>
            <body:MethodDefBody>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        children.push(parameters);
        children.push(body);
        Box::new(IntAstNode::new(IntAstKind::MethodDef, AstContent::None, children, start, end))
    },
}

pub MethodDefBody: Box<IntAstNode> = {
    <start:@L>
        ":task" <task:Task>
        <precondition:MethodPreconditionDef?>
        <task_network:TaskNetworkDef>
    <end:@R> => {
        let mut children = Vec::new();
        children.push(task);
        if let Some(precondition) = precondition {
            children.push(precondition);
        }
        children.push(task_network);
        Box::new(IntAstNode::new(IntAstKind::MethodDefBody, AstContent::None, children, start, end))
    },
}

pub InitialTaskNetwork : Box<IntAstNode> = {
     <start:@L>
        "(" ":htn"
        <parameters:ParameterDef?>
        <task_network:TaskNetworkDef> ")"
     <end:@R> => {
        let mut children = Vec::new();
        if let Some(parameters) = parameters {
            children.push(parameters);
        }
        children.push(task_network);
        Box::new(IntAstNode::new(IntAstKind::InitialTaskNetwork, AstContent::None, children, start, end))
     },
}

pub HDDLRequirement : Box<IntAstNode> = {
    <requirement:Requirement> => requirement,
    <start:@L> ":hierarchy" <end:@R> => {
            Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::Hierarchy), Vec::new(), start, end))
    },
    <start:@L> ":method-preconditions" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::MethodPreconditions), Vec::new(), start, end))
    },
}

pub HDDLRequireDef : Box<IntAstNode> = {
     <start:@L> "(" ":requirements" <requirements:HDDLRequirement*> ")" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::RequireDef, AstContent::None, requirements, start, end))
     },
}

pub HDDLStructureDef : Box<IntAstNode> = {
    <action:ActionDef> =>  action,
    <derived:DerivedDef> => derived,
    <durative_action:DurativeActionDef> => durative_action,
    <task:TaskDef> => task,
    <method:MethodDef> => method,
}

pub HDDLDomain : Box<IntAstNode> = {
    <start:@L>
        "(" "define" "(" "domain" <name:DomainName> ")"
            <require_def:HDDLRequireDef?>
            <types_def:TypesDef?>
            <constants_def:ConstantsDef?>
            <predicates_def:PredicatesDef?>
            <functions_def:FunctionsDef?>
            <structure_def:HDDLStructureDef*>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        if let Some(require_def) = require_def {
            children.push(require_def);
        }
        if let Some(types_def) = types_def {
            children.push(types_def);
        }
        if let Some(constants_def) = constants_def {
            children.push(constants_def);
        }
        if let Some(predicates_def) = predicates_def {
            children.push(predicates_def);
        }
        if let Some(functions_def) = functions_def {
            children.push(functions_def);
        }
        children.extend(structure_def);
        Box::new(IntAstNode::new(IntAstKind::Domain, AstContent::None, children, start, end))
    },
 }

pub HDDLProblem : Box<IntAstNode> = {
    <start:@L>
        "(" "define" "(" "problem" <problem_name:ProblemName> ")"
        "(" ":domain" <domain_name:DomainName> ")"
        <require_def:HDDLRequireDef?>
        <objects_def:ObjectsDef?>
        <task_network:InitialTaskNetwork>
        <init:Init>
        <goal:Goal?>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(problem_name);
        children.push(domain_name);
        if let Some(require_def) = require_def {
           children.push(require_def);
        }
        if let Some(objects_def) = objects_def {
           children.push(objects_def);
        }
        children.push(init);
        children.push(task_network);
        if let Some(goal) = goal {
            children.push(goal);
        }
        Box::new(IntAstNode::new(IntAstKind::Problem, AstContent::None, children, start, end))
    },
}

pub HDDL : Box<IntAstNode> = {
    <domain:HDDLDomain> => domain,
    <problem:HDDLProblem> => problem,
}
