pub StructureDef: Result<NodeId, ParseContextError> = {
    <action:ActionDef> => action,
    <derived:DerivedDef> => derived,
    <durative_action:DurativeActionDef> => durative_action,
}

pub ActionDef: Result<NodeId, ParseContextError> = {
    <start:@L>
        "(" ":action"
            <name:ActionSymbol>
            <parameters:ParameterDef>
            <body:ActionDefBody>
        ")"
    <end:@R> => {
        context.alloc_node(AstKind::ActionDef, AstContent::None, vec![name?, parameters?, body?], start, end)
    }
}

pub ParameterDef: Result<NodeId, ParseContextError> = {
    <start:@L>
       ":parameters" "(" <parameters:TypedList<Variable>> ")"
    <end:@R> => {
        context.alloc_node(AstKind::ParametersDef, AstContent::None, vec![parameters?], start, end)
    }
}

pub ActionDefBody: Result<NodeId, ParseContextError> = {
    <start:@L> <precondition:PreconditionDef?> <effect:EffectDef?> <end:@R> => {
        let mut children = Vec::new();
        if let Some(pre) = precondition {
            children.push(pre?);
        }
        if let Some(eff) = effect {
            children.push(eff?);
        }
        context.alloc_node(AstKind::ActionDefBody, AstContent::None, children, start, end)
    }
}

pub PreconditionDef: Result<NodeId, ParseContextError> = {
    <start:@L> ":precondition" <precondition:EmptyOr<PreGD>> <end:@R> => {
        context.alloc_node(AstKind::PreconditionDef, AstContent::None, vec![precondition?], start, end)
    }
}

pub EffectDef: Result<NodeId, ParseContextError> = {
    <start:@L> ":effect" <effect:EmptyAnd<Effect>> <end:@R> => {
        context.alloc_node(AstKind::EffectDef, AstContent::None, vec![effect?], start, end)
    }
}

EmptyOr<T>: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ")" <end:@R> => {
        context.alloc_node(AstKind::Or, AstContent::None, Vec::new(), start, end)
    },
    <start:@L> <element:T> <end:@R> => element,
}

EmptyAnd<T>: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ")" <end:@R> => {
        context.alloc_node(AstKind::And, AstContent::None, Vec::new(), start, end)
    },
    <start:@L> <element:T> <end:@R> => element,
}

pub PreGD: Result<NodeId, ParseContextError> = {
    <start:@L> <pref_gd:PrefGD> <end:@R> => pref_gd,
    <atom:AtomicFormula<Term>> => atom,
    <start:@L> "(" "and" <pre_gd:PreGD*> ")" <end:@R> => {
        let pre_gd = pre_gd.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::And, AstContent::None, pre_gd, start, end)
    },
    <start:@L> "(" "or" <gd:GD*> ")" <end:@R> => {
        let gd = gd.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::Or, AstContent::None, gd, start, end)
    },
    <start:@L> "(" "not" <gd:GD> ")" <end:@R> => {
        context.alloc_node(AstKind::Not, AstContent::None, vec![gd?], start, end)
    },
    <start:@L> "(" "imply" <antecedent:GD> <consequence:GD> ")" <end:@R> => {
        context.alloc_node(AstKind::Imply, AstContent::None, vec![antecedent?, consequence?], start, end)
    },
    <start:@L>
        "(" "exists"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        context.alloc_node(AstKind::Exists, AstContent::None, vec![variables?, gd?], start, end)
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <pre_gd:PreGD>
        ")"
    <end:@R> => {
        context.alloc_node(AstKind::Forall, AstContent::None, vec![variables?, pre_gd?], start, end)
    },
    <comparison:Comparison> => comparison,
}

pub PrefGD: Result<NodeId, ParseContextError> = {
    <start:@L> "(" "preference" <pref_name:PrefName?> <gd:GD> ")" <end:@R> => {
        let mut children = Vec::new();
        if let Some(pref_name) = pref_name {
            children.push(pref_name?);
        }
        children.push(gd?);
        context.alloc_node(AstKind::Preference, AstContent::None, children, start, end)
    },
}

pub GD: Result<NodeId, ParseContextError> = {
    <atom:AtomicFormula<Term>> => atom,
    <start:@L> "(" "and" <gd:GD*> ")" <end:@R> => {
        let gd = gd.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::And, AstContent::None, gd, start, end)
    },
    <start:@L> "(" "or" <gd:GD*> ")" <end:@R> => {
        let gd = gd.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::Or, AstContent::None, gd, start, end)
    },
    <start:@L> "(" "not" <gd:GD> ")" <end:@R> => {
        context.alloc_node(AstKind::Not, AstContent::None, vec![gd?], start, end)
    },
    <start:@L> "(" "imply" <antecedent:GD> <consequence:GD> ")" <end:@R> => {
        context.alloc_node(AstKind::Imply, AstContent::None, vec![antecedent?, consequence?], start, end)
    },
    <start:@L>
        "(" "exists"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        context.alloc_node(AstKind::Exists, AstContent::None, vec![variables?, gd?], start, end)
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        context.alloc_node(AstKind::Forall, AstContent::None, vec![variables?, gd?], start, end)
    },
    <comparison:Comparison> => comparison,
}

pub Effect: Result<NodeId, ParseContextError> = {
    <start:@L> "(" "and" <effects:CEffect*> ")" <end:@R> => {
        let effects = effects.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::And, AstContent::None, effects, start, end)
    },
    <effect:CEffect> => effect,
}

pub CEffect: Result<NodeId, ParseContextError> = {
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <effect:Effect>
        ")"
    <end:@R> => {
        context.alloc_node(AstKind::Forall, AstContent::None, vec![variables?, effect?], start, end)
    },
    <start:@L> "(" "when" <gd:GD> <effect:CondEffect> ")" <end:@R> => {
        context.alloc_node(AstKind::When, AstContent::None, vec![gd?, effect?], start, end)
    },
    <effect:PEffect> => effect,
}

pub PEffect: Result<NodeId, ParseContextError> = {
    <literal:Literal<Term>> => literal,
    <start:@L> "(" <op:AssignOp> <fhead:FHead> <fexp:_FExp> ")" <end:@R> => {
        context.alloc_node(AstKind::Assignment, op, vec![fhead?, fexp?], start, end)
    },
}

pub CondEffect: Result<NodeId, ParseContextError> = {
    <start:@L> "(" "and" <effects:PEffect*> ")" <end:@R> => {
        let effects = effects.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::And, AstContent::None, effects, start, end)
    },
    <effect:PEffect> => effect,
}

pub Term: Result<NodeId, ParseContextError> = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            context.alloc_node(AstKind::Object, AstContent::Ident(context.intern(name)), Vec::new(), start, end)
        } else {
            context.alloc_node(AstKind::Variable, AstContent::Ident(context.intern(name)), Vec::new(), start, end)
        }
    },
    <duration:DurationVariable> => duration,
    <function:FunctionTerm> => function,
}

pub FunctionTerm: Result<NodeId, ParseContextError> = {
    <function_term:_FunctionTerm<Term>> => function_term,
}

_FunctionTerm<T>: Result<NodeId, ParseContextError> = {
    <start:@L> "(" <function_symbol:FunctionSymbol> <arguments:T*> ")" <end:@R> => {
        let arguments = arguments.into_iter().collect::<Result<Vec<_>, _>>()?;
        let mut children = Vec::new();
        children.push(function_symbol?);
        children.extend(arguments);
        context.alloc_node(AstKind::Function, AstContent::None, children, start, end)
    }
}

pub Comparison: Result<NodeId, ParseContextError> = {
    <start:@L> "(" <comparator:CompareOp> <arg1:_FExp> <arg2:_FExp> ")" <end:@R> => {
        context.alloc_node(AstKind::Comparison, comparator, vec![arg1?, arg2?], start, end)
    }
}

pub CompareOp : AstContent = {
    ">" =>AstContent::CompareOp(CompareOp::Greater),
    "<" =>AstContent::CompareOp(CompareOp::Less),
    "=" =>AstContent::CompareOp(CompareOp::Equal),
    ">=" =>AstContent::CompareOp(CompareOp::GreaterEq),
    "<=" =>AstContent::CompareOp(CompareOp::LessEq),
}

pub AssignOp : AstContent = {
    "assign" =>AstContent::AssignOp(AssignOp::Assign),
    "scale-up" =>AstContent::AssignOp(AssignOp::ScaleUp),
    "scale-down" =>AstContent::AssignOp(AssignOp::ScaleDown),
    "increase" =>AstContent::AssignOp(AssignOp::Increase),
    "decrease" =>AstContent::AssignOp(AssignOp::Decrease),
}

pub ArithmeticOp : AstContent = {
    "-" =>AstContent::ArithmeticOp(ArithmeticOp::Sub),
    "+" =>AstContent::ArithmeticOp(ArithmeticOp::Add),
    "/" =>AstContent::ArithmeticOp(ArithmeticOp::Div),
    "*" =>AstContent::ArithmeticOp(ArithmeticOp::Mul),
}

Literal<T>: Result<NodeId, ParseContextError> = {
    <atom:AtomicFormula<T>> => atom,
    <start:@L> "(" "not" <atom:AtomicFormula<T>> ")" <end:@R> => {
        context.alloc_node(AstKind::Not, AstContent::None, vec![atom?], start, end)
    }
}

AtomicFormula<T>: Result<NodeId, ParseContextError> = {
    <start:@L> "(" <predicate:Predicate> <terms:T*> ")" <end:@R> => {
        let terms = terms.into_iter().collect::<Result<Vec<_>, _>>()?;
        let mut children = Vec::new();
        children.push(predicate?);
        children.extend(terms);
        context.alloc_node(AstKind::AtomicFormula, AstContent::None, children, start, end)
    }
}

_FExp: Result<NodeId, ParseContextError> = {
    <term:Term> => term,
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:_FExp> <arg2:_FExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1?);
        if let Some(arg2) = arg2 {
            children.push(arg2?);
        }
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Sub), children, start, end)
    },
    <start:@L> "(" "/" <arg1:_FExp> <arg2:_FExp> ")" <end:@R> => {
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Div), vec![arg1?, arg2?], start, end)
    },
    <start:@L> "(" "+" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let next_args = next_args.into_iter().collect::<Result<Vec<_>, _>>()?;
        let mut children = Vec::new();
        children.push(arg1?);
        children.extend(next_args);
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Add), children, start, end)
    },
    <start:@L> "(" "*" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1?);
        let next_args = next_args.into_iter().collect::<Result<Vec<_>, _>>()?;
        children.extend(next_args);
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Mul), children, start, end)
    },
}

