_FExp: Result<NodeId, ParseContextError> = {
    <term:Term> => term,
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:_FExp> <arg2:_FExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1?);
        if let Some(arg2) = arg2 {
            children.push(arg2?);
        }
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Sub), children, start, end)
    },
    <start:@L> "(" "/" <arg1:_FExp> <arg2:_FExp> ")" <end:@R> => {
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Div), vec![arg1?, arg2?], start, end)
    },
    <start:@L> "(" "+" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let next_args = next_args.into_iter().collect::<Result<Vec<_>, _>>()?;
        let mut children = Vec::new();
        children.push(arg1?);
        children.extend(next_args);
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Add), children, start, end)
    },
    <start:@L> "(" "*" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1?);
        let next_args = next_args.into_iter().collect::<Result<Vec<_>, _>>()?;
        children.extend(next_args);
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Mul), children, start, end)
    },
}

