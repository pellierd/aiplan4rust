    <start:@L>
        ":duration" <constraint:DurationConstraint>
        ":condition" <condition:EmptyOr<DAGD>>
        ":effect" <effect:EmptyAnd<DAEffect>>
    <end:@R> => {
        context.new_node(AstKind::DADefBody, AstContent::None, vec![constraint, condition, effect], start, end, None)
    }
