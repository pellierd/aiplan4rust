pub MetricFExp: Result<NodeId, ParseContextError> = {
    <number:Number> => number,
    <function:_FunctionTerm<Object>> => function,
    <start:@L> <symbol:FunctionSymbol> <end:@R> => {
        context.alloc_node(AstKind::Function, AstContent::None, vec![symbol?], start, end)
    },
    <start:@L> "(" "-" <arg1:MetricFExp> <arg2:MetricFExp?> ")" <end:@R> => {
        let mut children = vec![arg1?];
        if let Some(arg2) = arg2 {
            children.push(arg2?);
        }
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Sub), children, start, end)
    },
    <start:@L> "(" "/" <arg1:MetricFExp> <arg2:MetricFExp> ")" <end:@R> => {
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Div), vec![arg1?, arg2?], start, end)
    },
    <start:@L> "(" "+" <arg1:MetricFExp> <next_args:MetricFExp+> ")" <end:@R> => {
        let mut children = vec![arg1?];
        let next_args = next_args.into_iter().collect::<Result<Vec<_>, _>>()?;
        children.extend(next_args);
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Add), children, start, end)
    },
    <start:@L> "(" "*" <arg1:MetricFExp> <next_args:MetricFExp+> ")" <end:@R> => {
        let mut children = vec![arg1?];
        let next_args = next_args.into_iter().collect::<Result<Vec<_>, _>>()?;
        children.extend(next_args);
        context.alloc_node(AstKind::Arithmetic, AstContent::ArithmeticOp(ArithmeticOp::Mul), children, start, end)
    },
    //<start:@L> "total-time" <end:@R> => {
    //    Context.alloc_node(AstKind::TotalTime, AstContent::None, Vec::new(), start, end)
    //}
    <start:@L> "(" "is-violated" <pref:PrefName> ")" <end:@R> => {
        context.alloc_node(AstKind::IsViolated, AstContent::None, vec![pref?], start, end)
    }
}

pub MetricSpec: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ":metric" <op:OptimizationOp> <fexp:MetricFExp> ")" <end:@R> => {
        context.alloc_node(AstKind::Metric, op, vec![fexp?], start, end)
    },
}

pub LengthSpec: Result<NodeId, ParseContextError> = {
    <start:@L>
        "(" ":length"
            <start_serial:@L> "(" ":serial" <serial_value:"number"?> ")" <end_serial:@R>
            <start_parallel:@L> "(" ":parallel" <parallel_value:"number"?> ")" <end_parallel:@R>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        if let Some(serial_value) = serial_value {
            let serial = context.alloc_node(AstKind::Serial, AstContent::Number(OrderedFloat(serial_value)), vec![], start_serial, end_serial);
            children.push(serial?);
        }
        if let Some(parallel_value) = parallel_value {
            let parallel = context.alloc_node(AstKind::Parallel, AstContent::Number(OrderedFloat(parallel_value)), vec![], start_parallel, end_parallel);
            children.push(parallel?);
        }
        context.alloc_node(AstKind::Length, AstContent::None, children, start, end)
    },
}

pub Problem: Result<NodeId, ParseContextError> = {
    <start:@L>
        "(" "define" "(" "problem" <problem:ProblemName> ")"
        "(" ":domain" <domain:DomainName> ")"
        <require_def:RequireDef?>
        <objects_def:ObjectsDef?>
        <init:Init>
        <goal:Goal>
        <constraints:Constraints?>
        <metric_spec:MetricSpec?>
        <length_spec:LengthSpec?>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(problem?);
        children.push(domain?);
        if let Some(require_def) = require_def {
            children.push(require_def?)
        }
        if let Some(objects_def) = objects_def {
            children.push(objects_def?)
        }
        children.push(init?);
        children.push(goal?);
        if let Some(constraints) = constraints {
            children.push(constraints?)
        }
        if let Some(metric_spec) = metric_spec {
            children.push(metric_spec?)
        }
        if let Some(length_spec) = length_spec {
            children.push(length_spec?)
        }
        context.alloc_node(AstKind::Problem, AstContent::None, children, start, end)
    },
}

pub PDDL: Result<NodeId, ParseContextError> = {
    <domain:Domain> => domain,
    <problem:Problem> => problem,
}

///////////////////////////////////////////////////////////////////////////////////////////////
// HDDL Dialect
///////////////////////////////////////////////////////////////////////////////////////////////

pub TaskSymbol: Result<NodeId, ParseContextError> = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => context.alloc_node(AstKind::TaskSymbol, name, Vec::new(), start, end),
            Err(_) => context.alloc_node(AstKind::Error, AstContent::None, Vec::new(), start, end),
        }
    },
}

pub TaskDef: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ":task" <symbol:TaskSymbol> <parameters:ParameterDef> ")" <end:@R> => {
        context.alloc_node(AstKind::TaskDef, AstContent::None, vec![symbol?, parameters?], start, end)
    },
}

pub MethodSymbol: Result<NodeId, ParseContextError> = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => context.alloc_node(AstKind::MethodSymbol, name, Vec::new(), start, end),
            Err(_) => context.alloc_node(AstKind::Error, AstContent::None, Vec::new(), start, end),
        }
    },
}

pub TaskID: Result<NodeId, ParseContextError> = {
    <start:@L> <name:Name> <end:@R> => match name {
        Ok(name) => context.alloc_node(AstKind::TaskLabel, name, Vec::new(), start, end),
        Err(_) => context.alloc_node(AstKind::Error, AstContent::None, Vec::new(), start, end),
    }
}

pub TaskTerm: Result<NodeId, ParseContextError> = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            context.alloc_node(AstKind::Object, AstContent::Ident(context.intern(name.to_string())), Vec::new(), start, end)
        } else {
            context.alloc_node(AstKind::Variable, AstContent::Ident(context.intern(name.to_string())), Vec::new(), start, end)
        }
    }
}

pub Task: Result<NodeId, ParseContextError> = {
    <start:@L> "(" <symbol:TaskSymbol> <terms:TaskTerm*> ")" <end:@R> => {
        let terms = terms.into_iter().collect::<Result<Vec<_>, _>>()?;
        let mut children = Vec::new();
        children.push(symbol?);
        children.extend(terms);
        context.alloc_node(AstKind::Task, AstContent::None, children, start, end)
    }
}

pub Subtask: Result<NodeId, ParseContextError> = {
    "(" <start_name:@L> <name:Name> <end_name:@R> <rest:SubtaskRest> <end_rest:@R> => {
        let rest = rest?;
        match name {
            Ok(name_value) => {
                match rest.first().map(|node| context.borrow_syntax_tree().get_node(*node).unwrap().kind()) {
                    Some(AstKind::TaskSymbol) => {
                        let task_id = context.alloc_node(AstKind::TaskLabel, name_value, Vec::new(), start_name, end_name);
                        let task = context.alloc_node(AstKind::Task, AstContent::None, rest, end_name, end_rest);
                        context.alloc_node(AstKind::LabeledTask, AstContent::None, vec![task_id?, task?], start_name, end_rest)
                    },
                    Some(AstKind::Object) | Some(AstKind::Variable) => {
                        let task_symbol = context.alloc_node(AstKind::TaskSymbol, name_value, Vec::new(), start_name, end_name);
                        let mut children = Vec::with_capacity(1 + rest.len());
                        children.push(task_symbol?);
                        children.extend(rest);
                        context.alloc_node(AstKind::Task, AstContent::None, children, start_name, end_rest)
                    },
                    None => {
                        let task_symbol = context.alloc_node(AstKind::TaskSymbol, name_value, Vec::new(), start_name, end_name);
                        context.alloc_node(AstKind::Task, AstContent::None, vec![task_symbol?], start_name, end_rest)
                    },
                    _ => context.alloc_node(AstKind::Error, AstContent::None, Vec::new(), start_name, end_name)
                }
            },
            Err(_) => context.alloc_node(AstKind::Error, AstContent::None, Vec::new(), start_name, end_rest)
        }
    }
}

SubtaskRest: Result<Vec<NodeId>, ParseContextError> = {
    <start:@L> "(" <task_symbol:TaskSymbol> <terms:TaskTerm*> ")" ")" <end:@R> => {
        let terms = terms.into_iter().collect::<Result<Vec<_>, _>>()?;
        let mut children = Vec::new();
        children.push(task_symbol?);
        children.extend(terms);
        Ok(children)
    },
    <start:@L> <terms:TaskTerm*> ")" <end:@R> => {
        let terms = terms.into_iter().collect::<Result<Vec<_>, _>>()?;
        Ok(terms)
    }
}
pub SubtaskDef: Result<NodeId, ParseContextError> = {
    <start:@L> <subtask:Subtask> <end:@R> => {
        context.alloc_node(AstKind::And, AstContent::None, vec![subtask?], start, end)
    },
    <start:@L> "(" ")" <end:@R> => {
        context.alloc_node(AstKind::And, AstContent::None, vec![], start, end)
    },
    <start:@L> "(" "and" <subtasks:Subtask*> ")" <end:@R> => {
        let subtasks = subtasks.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::And, AstContent::None, subtasks, start, end)
    }
}

pub TaskNetworkSubtaskDef: Result<NodeId, ParseContextError> = {
    <start:@L> ":ordered-tasks" <subtasks:SubtaskDef> <end:@R> => {
        context.alloc_node(AstKind::OrderedSubtaskDef, AstContent::None, vec![subtasks?], start, end)
    },
    <start:@L> ":ordered-subtasks" <subtasks:SubtaskDef> <end:@R> => {
        context.alloc_node(AstKind::OrderedSubtaskDef, AstContent::None, vec![subtasks?], start, end)
    },
    <start:@L> ":tasks" <subtasks:SubtaskDef> <end:@R> => {
        context.alloc_node(AstKind::PartiallyOrderedSubtaskDef, AstContent::None, vec![subtasks?], start, end)
    },
    <start:@L> ":subtasks" <subtasks:SubtaskDef> <end:@R> => {
        context.alloc_node(AstKind::PartiallyOrderedSubtaskDef, AstContent::None, vec![subtasks?], start, end)
    }
}

pub SimpleTaskOrderingConstraint: Result<NodeId, ParseContextError> = {
    <start:@L> "(" "<" <t1:TaskID> <t2:TaskID> ")" <end:@R> => {
        context.alloc_node(AstKind::TaskOrderingConstraint, AstContent::CompareOp(CompareOp::Less), vec![t1?, t2?], start, end)
    }
}

pub TaskOrderingConstraint: Result<NodeId, ParseContextError> = {
    <start:@L> <constraint:SimpleTaskOrderingConstraint> <end:@R> => {
        context.alloc_node(AstKind::And, AstContent::None, vec![constraint?], start, end)
    },
    <start:@L> "(" ")" <end:@R> => {
        context.alloc_node(AstKind::And, AstContent::None, Vec::new(), start, end)
    },
    <start:@L> "(" "and" <constraints:SimpleTaskOrderingConstraint*> ")" <end:@R> => {
        let constraints = constraints.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::And, AstContent::None, constraints, start, end)
    },
}

pub TaskNetworkOrderingConstraintDef: Result<NodeId, ParseContextError> = {
    <start:@L> ":ordering" <constraints:TaskOrderingConstraint> <end:@R> => {
        context.alloc_node(AstKind::TaskOrderingConstraintDef, AstContent::None, vec![constraints?], start, end)
    },
    <start:@L> ":order" <constraints:TaskOrderingConstraint> <end:@R> => {
        context.alloc_node(AstKind::TaskOrderingConstraintDef, AstContent::None, vec![constraints?], start, end)
    },
}

pub SimpleTaskLogicalConstraint: Result<NodeId, ParseContextError> = {
    <start:@L> "(" "=" <t1:Term> <t2:Term> ")" <end:@R> => {
        context.alloc_node(AstKind::Comparison, AstContent::CompareOp(CompareOp::Equal), vec![t1?, t2?], start, end)
    },
    <start:@L> "(" "not" <constraint:SimpleTaskLogicalConstraint> ")" <end:@R> => {
        context.alloc_node(AstKind::Not, AstContent::None, vec![constraint?], start, end)
    },
}

pub TaskLogicalConstraint: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ")" <end:@R> => {
        context.alloc_node(AstKind::And, AstContent::None, Vec::new(), start, end)
    },
    <start:@L> <constraint:SimpleTaskLogicalConstraint> <end:@R> => {
        context.alloc_node(AstKind::And, AstContent::None, vec![constraint?], start, end)
    },
    <start:@L> "(" "and" <constraints:SimpleTaskLogicalConstraint*> ")" <end:@R> => {
        let constraints = constraints.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::And, AstContent::None, constraints, start, end)
    },
}

pub TaskNetworkLogicalConstraintDef: Result<NodeId, ParseContextError> = {
    <start:@L> ":constraints" <constraint:TaskLogicalConstraint> <end:@R> => {
        context.alloc_node(AstKind::TaskLogicalConstraintDef, AstContent::None, vec![constraint?], start, end)
    },
}

pub TaskNetworkDef: Result<NodeId, ParseContextError> = {
    <start:@L>
        <subtasks:TaskNetworkSubtaskDef?>
        <ordering_constraints:TaskNetworkOrderingConstraintDef?>
        <logical_constraints:TaskNetworkLogicalConstraintDef?>
    <end:@R> => {
        let mut children = Vec::new();
        if let Some(subtasks) = subtasks {
            children.push(subtasks?);
        }
        if let Some(ordering_constraints) = ordering_constraints {
            children.push(ordering_constraints?);
        }
        if let Some(logical_constraints) = logical_constraints {
            children.push(logical_constraints?);
        }
        context.alloc_node(AstKind::TaskNetworkDef, AstContent::None, children, start, end)
    },
}

pub MethodPreconditionDef: Result<NodeId, ParseContextError> = {
    <start:@L> ":precondition" <gd:EmptyOr<GD>> <end:@R> => {
        context.alloc_node(AstKind::MethodPreconditionDef, AstContent::None, vec![gd?], start, end)
    },
}

pub MethodDef: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ":method" <name:MethodSymbol> <parameters:ParameterDef> <body:MethodDefBody> ")" <end:@R> => {
        context.alloc_node(AstKind::MethodDef, AstContent::None, vec![name?, parameters?, body?], start, end)
    },
}

pub MethodDefBody: Result<NodeId, ParseContextError> = {
    <start:@L>
        ":task" <task:Task>
        <precondition:MethodPreconditionDef?>
        <task_network:TaskNetworkDef>
    <end:@R> => {
        let mut children = vec![task?];
        if let Some(precondition) = precondition {
            children.push(precondition?);
        }
        children.push(task_network?);
        context.alloc_node(AstKind::MethodDefBody, AstContent::None, children, start, end)
    },
}

pub InitialTaskNetwork: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ":htn" <parameters:ParameterDef?> <task_network:TaskNetworkDef> ")" <end:@R> => {
        let mut children = Vec::new();
        if let Some(parameters) = parameters {
            children.push(parameters?);
        }
        children.push(task_network?);
        context.alloc_node(AstKind::InitialTaskNetwork, AstContent::None, children, start, end)
    },
}

pub HDDLRequirement: Result<NodeId, ParseContextError> = {
    <requirement:Requirement> => requirement,
    <start:@L> ":hierarchy" <end:@R> => {
        context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::Hierarchy), Vec::new(), start, end)
    },
    <start:@L> ":method-preconditions" <end:@R> => {
        context.alloc_node(AstKind::Requirement, AstContent::Requirement(Requirement::MethodPreconditions), Vec::new(), start, end)
    },
}

pub HDDLRequireDef: Result<NodeId, ParseContextError> = {
    <start:@L> "(" ":requirements" <requirements:HDDLRequirement*> ")" <end:@R> => {
        let requirements = requirements.into_iter().collect::<Result<Vec<_>, _>>()?;
        context.alloc_node(AstKind::RequireDef, AstContent::None, requirements, start, end)
    },
}

DomainElement : Result<NodeId, ParseContextError> = {
    <task_def:TaskDef> => task_def,
    <predicate_def:PredicatesDef> => predicate_def,
    <function_def:FunctionsDef> => function_def,
    <action_def:ActionDef> => action_def,
    <method_def:MethodDef> => method_def,
    <derived_def:DerivedDef> => derived_def,
    <durative_action_def:DurativeActionDef> => durative_action_def,
};

pub HDDLDomain: Result<NodeId, ParseContextError> = {
    <start:@L>
        "(" "define" "(" "domain" <name:DomainName> ")"
            <require_def:HDDLRequireDef?>
            <types_def:TypesDef?>
            <constants_def:ConstantsDef?>
            <elements:DomainElement*>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name?);
        if let Some(req) = require_def { children.push(req?); }
        if let Some(types) = types_def { children.push(types?); }
        if let Some(constants) = constants_def { children.push(constants?); }

        // Séparer les éléments par type
        let mut predicates = None;
        let mut functions = None;
        let mut tasks = Vec::new();
        let mut actions = Vec::new();
        let mut durative = Vec::new();
        let mut methods = Vec::new();
        let mut derived = Vec::new();

        let elements = elements.into_iter().collect::<Result<Vec<_>, _>>()?;
        for node_id in elements {
            let node = context.borrow_syntax_tree().try_node(node_id)?.clone();
            match node.kind() {
                AstKind::PredicatesDef => {
                    if predicates.is_some() {
                       context.push_custom_error(CustomParseError::duplicate_definition_block(
                            AstKind::PredicatesDef,
                            node.span().start(),
                            node.span().end()
                       ));
                       continue;
                    }
                    // Check def order
                    let mut invalid_def = Vec::new();
                    if !derived.is_empty() { invalid_def.push(AstKind::DerivedDef); }
                    if !actions.is_empty() { invalid_def.push(AstKind::ActionDef); }
                    if !durative.is_empty() { invalid_def.push(AstKind::DurativeActionDef); }
                    if !methods.is_empty() { invalid_def.push(AstKind::MethodDef); }

                    if !invalid_def.is_empty() {
                        context.push_custom_error(CustomParseError::invalid_definition_block_order(
                            AstKind::PredicatesDef,
                            node.span().start(),
                            node.span().end(),
                            invalid_def,
                        ));
                        continue;
                    }
                    predicates = Some(node_id);
                }
                AstKind::FunctionsDef => {
                    // Check for duplicate function section
                    if functions.is_some() {
                        context.push_custom_error(CustomParseError::duplicate_definition_block(
                            AstKind::FunctionsDef,
                            node.span().start(),
                            node.span().end(),
                        ));
                        continue; // Skip this node but keep parsing the rest
                    }

                    // Verify the order of sections: functions must come before derived/actions/durative/methods
                    let mut invalid_def = Vec::new();
                    if !derived.is_empty() { invalid_def.push(AstKind::DerivedDef); }
                    if !actions.is_empty() { invalid_def.push(AstKind::ActionDef); }
                    if !durative.is_empty() { invalid_def.push(AstKind::DurativeActionDef); }
                    if !methods.is_empty() { invalid_def.push(AstKind::MethodDef); }

                    if !invalid_def.is_empty() {
                        context.push_custom_error(CustomParseError::invalid_definition_block_order(
                            AstKind::FunctionsDef,
                            node.span().start(),
                            node.span().end(),
                            invalid_def,
                        ));
                        continue; // Continue parsing despite the ordering error
                    }

                    // Everything is correct, store the functions node
                    functions = Some(node_id);
                }
                AstKind::DerivedDef => {
                    // Check if Derived section comes before actions/durative/methods
                    let mut invalid_def = Vec::new();
                    if !actions.is_empty() { invalid_def.push(AstKind::ActionDef); }
                    if !durative.is_empty() { invalid_def.push(AstKind::DurativeActionDef); }
                    if !methods.is_empty() { invalid_def.push(AstKind::MethodDef); }

                    if !invalid_def.is_empty() {
                        context.push_custom_error(CustomParseError::invalid_definition_block_order(
                            AstKind::DerivedDef,
                            node.span().start(),
                            node.span().end(),
                            invalid_def,
                        ));
                        continue; // Continue parsing despite the ordering error
                    }

                    // Everything is correct, store the derived node
                    derived.push(node_id);
                }

                AstKind::TaskDef => {
                    // Check that Task section comes before Method definitions
                    if !methods.is_empty() {
                        context.push_custom_error(CustomParseError::invalid_definition_block_order(
                            AstKind::TaskDef,
                            node.span().start(),
                            node.span().end(),
                            vec![AstKind::MethodDef],
                        ));
                        continue; // Continue parsing even if the order is invalid
                    }

                    // Everything is correct, store the task node
                    tasks.push(node_id);
                }
                AstKind::ActionDef => actions.push(node_id),
                AstKind::DurativeActionDef => durative.push(node_id),
                AstKind::MethodDef => methods.push(node_id),
                _ => {}
            }
        }

        // Add section in the good order
        if let Some(p) = predicates { children.push(p); }
        if let Some(f) = functions { children.push(f); }
        children.extend(tasks);
        children.extend(actions);
        children.extend(methods);
        children.extend(durative);
        children.extend(derived);

        context.alloc_node(AstKind::Domain, AstContent::None, children, start, end)
    },
};

