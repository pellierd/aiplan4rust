    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => context.alloc_node(AstKind::FunctionSymbol, name, Vec::new(), start, end),
            Err(_) => context.alloc_node(AstKind::Error, AstContent::None, Vec::new(), start, end),
        }
    },
}

pub Number: Result<NodeId, ParseContextError> = {
    <start:@L> <value:"number"> <end:@R> => {
        context.alloc_node(AstKind::Number, AstContent::Number(OrderedFloat(value)), Vec::new(), start, end)
    },
}

