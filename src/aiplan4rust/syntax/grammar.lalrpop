ProblemStructureDef : Result<(NodeId, NodeId, Option<NodeId>), ParseContextError> =
{
    // Without goal (2 permutations)
    <tn:InitialTaskNetwork> <init:Init>
        => Ok((tn?, init?, None)),
    <init:Init> <tn:InitialTaskNetwork>
        => Ok((tn?, init?, None)),

    // With goal (6 permutations)
    <tn:InitialTaskNetwork> <init:Init> <goal:Goal>
        => Ok((tn?, init?, Some(goal?))),
    <tn:InitialTaskNetwork> <goal:Goal> <init:Init>
        => Ok((tn?, init?, Some(goal?))),

    <init:Init> <tn:InitialTaskNetwork> <goal:Goal>
        => Ok((tn?, init?, Some(goal?))),
    <init:Init> <goal:Goal> <tn:InitialTaskNetwork>
        => Ok((tn?, init?, Some(goal?))),

    <goal:Goal> <tn:InitialTaskNetwork> <init:Init>
        => Ok((tn?, init?, Some(goal?))),
    <goal:Goal> <init:Init> <tn:InitialTaskNetwork>
        => Ok((tn?, init?, Some(goal?))),
};

pub HDDLProblem : Result<NodeId, ParseContextError> = {
    <start:@L>
        "(" "define" "(" "problem" <problem_name:ProblemName> ")"
        "(" ":domain" <domain_name:DomainName> ")"
        <require_def:HDDLRequireDef?>
        <objects_def:ObjectsDef?>
        <structure_def:ProblemStructureDef>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(problem_name?);
        children.push(domain_name?);
        if let Some(require_def) = require_def {
           children.push(require_def?);
        }
        if let Some(objects_def) = objects_def {
           children.push(objects_def?);
        }
        let (task_network, init, goal) = structure_def?;
        children.push(task_network);
        children.push(init);
        if let Some(goal) = goal {
            children.push(goal);
        }
        context.alloc_node(AstKind::Problem, AstContent::None, children, start, end)
    },
}

pub HDDL: Result<NodeId, ParseContextError> = {
    <domain:HDDLDomain> => domain,
    <problem:HDDLProblem> => problem,
}
