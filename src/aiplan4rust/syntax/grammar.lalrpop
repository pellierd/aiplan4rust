    <start:@L> "(" <op:AssignOp> <fhead:FHead> <fexpda:FExpDA> ")" <end:@R> => {
        context.new_node(AstKind::Assign, op, vec![fhead, fexpda], start, end, None)
    },
}

pub AssignOpT : AstContent = {
    "increase" =>AstContent::AssignOp(AssignOp::Increase),
    "decrease" =>AstContent::AssignOp(AssignOp::Decrease),
}

pub FExpT: NodeId = {
    <start:@L> "(" "*" <fexp:FExp> <var:ContinusVariable> ")" <end:@R> => {
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Mul), vec![fexp, var], start, end, None)
    },
    <start:@L> "(" "*" <var:ContinusVariable> <fexp:FExp> ")" <end:@R> => {
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Mul), vec![var, fexp], start, end, None)
    },
    <var:ContinusVariable> => var,
}

pub ContinusVariable: NodeId = {
    <start:@L> <var:"#t"> <end:@R> => {
        context.new_node(AstKind::Variable, AstContent::Ident(context.intern(var.to_string())), Vec::new(), start, end, None)
    }
}

pub Domain: NodeId = {
    <start:@L>
        "(" "define" "(" "domain" <name:DomainName> ")"
            <require_def:RequireDef?>
            <types_def:TypesDef?>
            <constants_def:ConstantsDef?>
            <predicates_def:PredicatesDef?>
            <functions_def:FunctionsDef?>
            <constraints:Constraints?>
            <structure_def:StructureDef*>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        if let Some(require_def) = require_def {
            children.push(require_def);
        }
        if let Some(types_def) = types_def {
            children.push(types_def);
        }
        if let Some(constants_def) = constants_def {
            children.push(constants_def);
        }
        if let Some(predicates_def) = predicates_def {
            children.push(predicates_def);
        }
        if let Some(functions_def) = functions_def {
            children.push(functions_def);
        }
        if let Some(constraints) = constraints {
            children.push(constraints);
        }
        children.extend(structure_def);
        context.new_node(AstKind::Domain, AstContent::None, children, start, end, None)
    }
}

pub ObjectsDef: NodeId = {
    <start:@L> "(" ":objects" <objects:TypedList<Constant>> ")" <end:@R> => {
        context.new_node(AstKind::ObjectsDef, AstContent::None, vec![objects], start, end, None)
    }
}

pub BasicFunctionTerm : NodeId = {
    <function:FunctionTerm> => function,
    <symbol:FunctionSymbol> => symbol,
}

pub InitEl: NodeId = {
    <literal:Literal<Constant>> => literal,
    <start:@L> "(" <number:Number> <literal:Literal<Constant>> ")" <end:@R> => {
        context.new_node(AstKind::TimedInitialLiteral, AstContent::None, vec![number, literal], start, end, None)
    },
    <start:@L> "(" "=" <function:BasicFunctionTerm> <number:Number> ")" <end:@R> => {
        context.new_node(AstKind::FComp, AstContent::BinaryComp(BinaryComp::Equal), vec![function, number], start, end, None)
    },
    <start:@L> "(" "=" <function:BasicFunctionTerm> <constant:Constant> ")" <end:@R> => {
        context.new_node(AstKind::FComp, AstContent::BinaryComp(BinaryComp::Equal), vec![function, constant], start, end, None)
    },
}

pub Init: NodeId = {
    <start:@L> "(" ":init" <init_els:InitEl*> ")" <end:@R> => {
        // Add and expression to uniformize
        let and_node = context.new_node(AstKind::And, AstContent::None, init_els, start, end, None);
        context.new_node(AstKind::Init, AstContent::None, vec![and_node], start, end, None)
    },
}

pub Goal: NodeId = {
    <start:@L> "(" ":goal" <pre_gd:PreGD> ")" <end:@R> => {
        let children = vec![pre_gd];
        context.new_node(AstKind::Goal, AstContent::None, children, start, end, None)
    },
}

pub Optimization : AstContent = {
    "minimize" => AstContent::Optimization(Optimization::Minimize),
    "maximize" => AstContent::Optimization(Optimization::Maximize),
}

pub MetricFExp: NodeId = {
    <number:Number> => number,
    <function:_FunctionTerm<Constant>> => function,
    <start:@L> <symbol:FunctionSymbol> <end:@R> => {
        context.new_node(AstKind::FunctionTerm, AstContent::None, vec![symbol], start, end, None)
    },
    <start:@L> "(" "-" <arg1:MetricFExp> <arg2:MetricFExp?> ")" <end:@R> => {
        let mut children = vec![arg1];
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Sub), children, start, end, None)
    },
    <start:@L> "(" "/" <arg1:MetricFExp> <arg2:MetricFExp> ")" <end:@R> => {
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Div), vec![arg1, arg2], start, end, None)
    },
    <start:@L> "(" "+" <arg1:MetricFExp> <next_args:MetricFExp+> ")" <end:@R> => {
        let mut children = vec![arg1];
        children.extend(next_args);
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Add), children, start, end, None)
    },
    <start:@L> "(" "*" <arg1:MetricFExp> <next_args:MetricFExp+> ")" <end:@R> => {
        let mut children = vec![arg1];
        children.extend(next_args);
        context.new_node(AstKind::Operation, AstContent::ArithmeticOp(ArithmeticOp::Mul), children, start, end, None)
    },
    //<start:@L> "total-time" <end:@R> => {
    //    Context.new_node(AstKind::TotalTime, AstContent::None, Vec::new(), start, end, None)
    //}
    <start:@L> "(" "is-violated" <pref:PrefName> ")" <end:@R> => {
        context.new_node(AstKind::IsViolated, AstContent::None, vec![pref], start, end, None)
    }
}

pub MetricSpec: NodeId = {
    <start:@L> "(" ":metric" <op:Optimization> <fexp:MetricFExp> ")" <end:@R> => {
        context.new_node(AstKind::Metric, op, vec![fexp], start, end, None)
    },
}

pub LengthSpec: NodeId = {
    <start:@L>
        "(" ":length"
            <start_serial:@L> "(" ":serial" <serial_value:"number"?> ")" <end_serial:@R>
            <start_parallel:@L> "(" ":parallel" <parallel_value:"number"?> ")" <end_parallel:@R>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        if let Some(serial_value) = serial_value {
            children.push(context.new_node(AstKind::Serial, AstContent::Float(OrderedFloat(serial_value)), vec![], start_serial, end_serial, None));
        }
        if let Some(parallel_value) = parallel_value {
            children.push(context.new_node(AstKind::Parallel, AstContent::Float(OrderedFloat(parallel_value)), vec![], start_parallel, end_parallel, None));
        }
        context.new_node(AstKind::Length, AstContent::None, children, start, end, None)
    },
}

pub Problem: NodeId = {
    <start:@L>
        "(" "define" "(" "problem" <problem:ProblemName> ")"
        "(" ":domain" <domain:DomainName> ")"
        <require_def:RequireDef?>
        <objects_def:ObjectsDef?>
        <init:Init>
        <goal:Goal>
        <constraints:Constraints?>
        <metric_spec:MetricSpec?>
        <length_spec:LengthSpec?>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(problem);
        children.push(domain);
        if let Some(require_def) = require_def {
            children.push(require_def)
        }
        if let Some(objects_def) = objects_def {
            children.push(objects_def)
        }
        children.push(init);
        children.push(goal);
        if let Some(constraints) = constraints {
            children.push(constraints)
        }
        if let Some(metric_spec) = metric_spec {
            children.push(metric_spec)
        }
        if let Some(length_spec) = length_spec {
            children.push(length_spec)
        }
        context.new_node(AstKind::Problem, AstContent::None, children, start, end, None)
    },
}

pub PDDL: NodeId = {
    <domain:Domain> => domain,
    <problem:Problem> => problem,
}

///////////////////////////////////////////////////////////////////////////////////////////////
// HDDL Dialect
///////////////////////////////////////////////////////////////////////////////////////////////

pub TaskSymbol: NodeId = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => context.new_node(AstKind::TaskSymbol, name, Vec::new(), start, end, None),
            Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None),
        }
    },
}

pub TaskDef: NodeId = {
    <start:@L> "(" ":task" <symbol:TaskSymbol> <parameters:ParameterDef> ")" <end:@R> => {
        context.new_node(AstKind::TaskDef, AstContent::None, vec![symbol, parameters], start, end, None)
    },
}

pub MethodSymbol: NodeId = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => context.new_node(AstKind::MethodSymbol, name, Vec::new(), start, end, None),
            Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None),
        }
    },
}

pub TaskID: NodeId = {
    <start:@L> <name:Name> <end:@R> => match name {
        Ok(name) => context.new_node(AstKind::TaskID, name, Vec::new(), start, end, None),
        Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None),
    }
}

pub TaskTerm: NodeId = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            context.new_node(AstKind::Constant, AstContent::Ident(context.intern(name.to_string())), Vec::new(), start, end, None)
        } else {
            context.new_node(AstKind::Variable, AstContent::Ident(context.intern(name.to_string())), Vec::new(), start, end, None)
        }
    }
}

pub Task: NodeId = {
    <start:@L> "(" <symbol:TaskSymbol> <terms:TaskTerm*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(symbol);
        children.extend(terms);
        context.new_node(AstKind::Task, AstContent::None, children, start, end, None)
    }
}

pub Subtask: NodeId = {
    "(" <start_name:@L> <name:Name> <end_name:@R> <rest:SubtaskRest> <end_rest:@R> => {
        match name {
            Ok(name_value) => {
                match rest.first().map(|node| context.arena().get_node(*node).unwrap().kind()) {
                    Some(AstKind::TaskSymbol) => {
                        let task_id = context.new_node(AstKind::TaskID, name_value, Vec::new(), start_name, end_name, None);
                        let task = context.new_node(AstKind::Task, AstContent::None, rest, end_name, end_rest, None);
                        context.new_node(AstKind::TaggedTask, AstContent::None, vec![task_id, task], start_name, end_rest, None)
                    },
                    Some(AstKind::Constant) | Some(AstKind::Variable) => {
                        let task_symbol = context.new_node(AstKind::TaskSymbol, name_value, Vec::new(), start_name, end_name, None);
                        let mut children = Vec::with_capacity(1 + rest.len());
                        children.push(task_symbol);
                        children.extend(rest);
                        context.new_node(AstKind::Task, AstContent::None, children, start_name, end_rest, None)
                    },
                    None => {
                        let task_symbol = context.new_node(AstKind::TaskSymbol, name_value, Vec::new(), start_name, end_name, None);
                        context.new_node(AstKind::Task, AstContent::None, vec![task_symbol], start_name, end_rest, None)
                    },
                    _ => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start_name, end_name, None)
                }
            },
            Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start_name, end_rest, None)
        }
    }
}

SubtaskRest: Vec<NodeId> = {
    <start:@L> "(" <task_symbol:TaskSymbol> <terms:TaskTerm*> ")" ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(task_symbol);
        children.extend(terms);
        children
    },
    <start:@L> <terms:TaskTerm*> ")" <end:@R> => terms,
}
pub SubtaskDef: NodeId = {
    <start:@L> <subtask:Subtask> <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, vec![subtask], start, end, None)
    },
    <start:@L> "(" ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, vec![], start, end, None)
    },
    <start:@L> "(" "and" <subtasks:Subtask*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, subtasks, start, end, None)
    }
}

pub TaskNetworkSubtaskDef: NodeId = {
    <start:@L> ":ordered-tasks" <subtasks:SubtaskDef> <end:@R> => {
        context.new_node(AstKind::OrderedSubtaskDef, AstContent::None, vec![subtasks], start, end, None)
    },
    <start:@L> ":ordered-subtasks" <subtasks:SubtaskDef> <end:@R> => {
        context.new_node(AstKind::OrderedSubtaskDef, AstContent::None, vec![subtasks], start, end, None)
    },
    <start:@L> ":tasks" <subtasks:SubtaskDef> <end:@R> => {
        context.new_node(AstKind::PartiallyOrderedSubtaskDef, AstContent::None, vec![subtasks], start, end, None)
    },
    <start:@L> ":subtasks" <subtasks:SubtaskDef> <end:@R> => {
        context.new_node(AstKind::PartiallyOrderedSubtaskDef, AstContent::None, vec![subtasks], start, end, None)
    }
}

pub SimpleTaskOrderingConstraint: NodeId = {
    <start:@L> "(" "<" <t1:TaskID> <t2:TaskID> ")" <end:@R> => {
        context.new_node(AstKind::TaskOrderingConstraint, AstContent::BinaryComp(BinaryComp::Less), vec![t1, t2], start, end, None)
    }
}

pub TaskOrderingConstraint: NodeId = {
    <start:@L> <constraint:SimpleTaskOrderingConstraint> <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, vec![constraint], start, end, None)
    },
    <start:@L> "(" ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, Vec::new(), start, end, None)
    },
    <start:@L> "(" "and" <constraints:SimpleTaskOrderingConstraint*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, constraints, start, end, None)
    },
}

pub TaskNetworkOrderingConstraintDef: NodeId = {
    <start:@L> ":ordering" <constraints:TaskOrderingConstraint> <end:@R> => {
        context.new_node(AstKind::TaskOrderingConstraintDef, AstContent::None, vec![constraints], start, end, None)
    },
    <start:@L> ":order" <constraints:TaskOrderingConstraint> <end:@R> => {
        context.new_node(AstKind::TaskOrderingConstraintDef, AstContent::None, vec![constraints], start, end, None)
    },
}

pub SimpleTaskLogicalConstraint: NodeId = {
    <start:@L> "(" "=" <t1:Term> <t2:Term> ")" <end:@R> => {
        context.new_node(AstKind::FComp, AstContent::BinaryComp(BinaryComp::Equal), vec![t1, t2], start, end, None)
    },
    <start:@L> "(" "not" <constraint:SimpleTaskLogicalConstraint> ")" <end:@R> => {
        context.new_node(AstKind::Not, AstContent::None, vec![constraint], start, end, None)
    },
}

pub TaskLogicalConstraint: NodeId = {
    <start:@L> "(" ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, Vec::new(), start, end, None)
    },
    <start:@L> <constraint:SimpleTaskLogicalConstraint> <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, vec![constraint], start, end, None)
    },
    <start:@L> "(" "and" <constraints:SimpleTaskLogicalConstraint*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, constraints, start, end, None)
    },
}

pub TaskNetworkLogicalConstraintDef: NodeId = {
    <start:@L> ":constraints" <constraint:TaskLogicalConstraint> <end:@R> => {
        context.new_node(AstKind::TaskLogicalConstraintDef, AstContent::None, vec![constraint], start, end, None)
    },
}

pub TaskNetworkDef: NodeId = {
    <start:@L>
        <subtasks:TaskNetworkSubtaskDef?>
        <ordering_constraints:TaskNetworkOrderingConstraintDef?>
        <logical_constraints:TaskNetworkLogicalConstraintDef?>
    <end:@R> => {
        let mut children = Vec::new();
        if let Some(subtasks) = subtasks {
            children.push(subtasks);
        }
        if let Some(ordering_constraints) = ordering_constraints {
            children.push(ordering_constraints);
        }
        if let Some(logical_constraints) = logical_constraints {
            children.push(logical_constraints);
        }
        context.new_node(AstKind::TaskNetworkDef, AstContent::None, children, start, end, None)
    },
}

pub MethodPreconditionDef: NodeId = {
    <start:@L> ":precondition" <gd:EmptyOr<GD>> <end:@R> => {
        context.new_node(AstKind::MethodPreconditionDef, AstContent::None, vec![gd], start, end, None)
    },
}

pub MethodDef: NodeId = {
    <start:@L> "(" ":method" <name:MethodSymbol> <parameters:ParameterDef> <body:MethodDefBody> ")" <end:@R> => {
        context.new_node(AstKind::MethodDef, AstContent::None, vec![name, parameters, body], start, end, None)
    },
}

pub MethodDefBody: NodeId = {
    <start:@L>
        ":task" <task:Task>
        <precondition:MethodPreconditionDef?>
        <task_network:TaskNetworkDef>
    <end:@R> => {
        let mut children = vec![task];
        if let Some(precondition) = precondition {
            children.push(precondition);
        }
        children.push(task_network);
        context.new_node(AstKind::MethodDefBody, AstContent::None, children, start, end, None)
    },
}

pub InitialTaskNetwork: NodeId = {
    <start:@L> "(" ":htn" <parameters:ParameterDef?> <task_network:TaskNetworkDef> ")" <end:@R> => {
        let mut children = Vec::new();
        if let Some(parameters) = parameters {
            children.push(parameters);
        }
        children.push(task_network);
        context.new_node(AstKind::InitialTaskNetwork, AstContent::None, children, start, end, None)
    },
}

pub HDDLRequirement: NodeId = {
    <requirement:Requirement> => requirement,
    <start:@L> ":hierarchy" <end:@R> => {
        context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::Hierarchy), Vec::new(), start, end, None)
    },
    <start:@L> ":method-preconditions" <end:@R> => {
        context.new_node(AstKind::Requirement, AstContent::Requirement(Requirement::MethodPreconditions), Vec::new(), start, end, None)
    },
}

pub HDDLRequireDef: NodeId = {
    <start:@L> "(" ":requirements" <requirements:HDDLRequirement*> ")" <end:@R> => {
        context.new_node(AstKind::RequireDef, AstContent::None, requirements, start, end, None)
    },
}

pub HDDLStructureDef: NodeId = {
    <action:ActionDef> => action,
    <derived:DerivedDef> => derived,
    <durative_action:DurativeActionDef> => durative_action,
    <task:TaskDef> => task,
    <method:MethodDef> => method,
}

pub HDDLDomain: NodeId = {
    <start:@L>
        "(" "define" "(" "domain" <name:DomainName> ")"
            <require_def:HDDLRequireDef?>
            <types_def:TypesDef?>
            <constants_def:ConstantsDef?>
            <predicates_def:PredicatesDef?>
            <functions_def:FunctionsDef?>
            <structure_def:HDDLStructureDef*>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        if let Some(require_def) = require_def {
            children.push(require_def);
        }
        if let Some(types_def) = types_def {
            children.push(types_def);
        }
        if let Some(constants_def) = constants_def {
            children.push(constants_def);
        }
        if let Some(predicates_def) = predicates_def {
            children.push(predicates_def);
        }
        if let Some(functions_def) = functions_def {
            children.push(functions_def);
        }
        children.extend(structure_def);
        let root_id = context.new_node(AstKind::Domain, AstContent::None, children, start, end, None);
        context.set_root_id(root_id);
        root_id
    },
}

pub HDDLProblem: NodeId = {
    <start:@L>
        "(" "define" "(" "problem" <problem_name:ProblemName> ")"
        "(" ":domain" <domain_name:DomainName> ")"
        <require_def:HDDLRequireDef?>
        <objects_def:ObjectsDef?>
        <task_network:InitialTaskNetwork>
        <init:Init>
        <goal:Goal?>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(problem_name);
        children.push(domain_name);
        if let Some(require_def) = require_def {
            children.push(require_def);
        }
        if let Some(objects_def) = objects_def {
            children.push(objects_def);
        }
        children.push(task_network);
        children.push(init);
        if let Some(goal) = goal {
            children.push(goal);
        }
        context.new_node(AstKind::Problem, AstContent::None, children, start, end, None)
    },
}

pub HDDL: NodeId = {
    <domain:HDDLDomain> => domain,
    <problem:HDDLProblem> => problem,
}
