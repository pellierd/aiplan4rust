pub Term: Result<NodeId, ParseContextError> = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            context.alloc_node(AstKind::Object, AstContent::Ident(context.intern(name)), Vec::new(), start, end)
        } else {
            context.alloc_node(AstKind::Variable, AstContent::Ident(context.intern(name)), Vec::new(), start, end)
        }
    },
    <duration:DurationVariable> => duration,
    <function:FunctionTerm> => function,
}

pub FunctionTerm: Result<NodeId, ParseContextError> = {
    <function_term:_FunctionTerm<Term>> => function_term,
}

_FunctionTerm<T>: Result<NodeId, ParseContextError> = {
    <start:@L> "(" <function_symbol:FunctionSymbol> <arguments:T*> ")" <end:@R> => {
        let arguments = arguments.into_iter().collect::<Result<Vec<_>, _>>()?;
        let mut children = Vec::new();
        children.push(function_symbol?);
        children.extend(arguments);
        context.alloc_node(AstKind::Function, AstContent::None, children, start, end)
    }
}

pub Comparison: Result<NodeId, ParseContextError> = {
    <start:@L> "(" <comparator:CompareOp> <arg1:_FExp> <arg2:_FExp> ")" <end:@R> => {
        context.alloc_node(AstKind::Comparison, comparator, vec![arg1?, arg2?], start, end)
    }
}

pub CompareOp : AstContent = {
    ">" =>AstContent::CompareOp(CompareOp::Greater),
    "<" =>AstContent::CompareOp(CompareOp::Less),
    "=" =>AstContent::CompareOp(CompareOp::Equal),
    ">=" =>AstContent::CompareOp(CompareOp::GreaterEq),
    "<=" =>AstContent::CompareOp(CompareOp::LessEq),
}

pub AssignOp : AstContent = {
    "assign" =>AstContent::AssignOp(AssignOp::Assign),
    "scale-up" =>AstContent::AssignOp(AssignOp::ScaleUp),
    "scale-down" =>AstContent::AssignOp(AssignOp::ScaleDown),
    "increase" =>AstContent::AssignOp(AssignOp::Increase),
