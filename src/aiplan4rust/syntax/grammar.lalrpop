use lalrpop_util::ErrorRecovery;
use lalrpop_util::ParseError;
use ordered_float::OrderedFloat;

use crate::aiplan4rust::lang::ArithmeticOp;
use crate::aiplan4rust::lang::AssignOp;
use crate::aiplan4rust::lang::BinaryComp;
use crate::aiplan4rust::lang::Optimization;
use crate::aiplan4rust::lang::Requirement;
use crate::aiplan4rust::syntax::lexer::LexicalError;
use crate::aiplan4rust::syntax::lexer::Token;
use crate::aiplan4rust::syntax::ast::AstKind;
use crate::aiplan4rust::syntax::ast::AstContent;
use crate::aiplan4rust::syntax::ParseContext;
use crate::aiplan4rust::tree::NodeId;

use crate::aiplan4rust::frontend::ParserInternalError;


grammar<'ctx>(context: &'ctx mut ParseContext);

extern {

  type Location = usize;
  type Error = LexicalError;

    enum Token {

       // Identifiers
       "id" => Token::ID(<String>),
       //"?id" => Token::VarID(<String>),
       "number" => Token::Number(<f64>),

        // Keywords
        "define" => Token::Define,
        "domain" => Token::Domain,
        "problem" => Token::Problem,
        ":requirements" => Token::Requirements,
        ":types" => Token::Types,
        "either" => Token::Either,
        ":constants" => Token::Constants,
        ":predicates" => Token::Predicates,
        ":functions" => Token::Functions,
        ":action" => Token::Action,
        ":parameters" => Token::Parameters,
        ":precondition" => Token::Precondition,
        ":effect" => Token::Effect,
        ":derived" => Token::Derived,
        ":durative-action" => Token::DurativeAction,
        ":duration" => Token::Duration,
        ":condition" => Token::Condition,
        ":domain" => Token::DomainDef,
        ":objects" => Token::Objects,
        ":init" => Token::Init,
        ":goal" => Token::Goal,
        ":metric" => Token::Metric,

        // Deprecated since PDDL2.1
        ":length" => Token::Length,
        ":serial" => Token::Serial,
        ":parallel" => Token::Parallel,

        // Expressions
        "preference" => Token::Preference,
        "and" => Token::And,
        "or" => Token::Or,
        "not" => Token::Not,
        "imply" => Token::Imply,
        "forall" => Token::Forall,
        "exists" => Token::Exists,
        "when" => Token::When,

        // Requirements
        ":strips" => Token::Strips,
        ":typing" => Token::Typing,
        ":negative-preconditions" => Token::NegativePreconditions,
        ":disjunctive-preconditions" => Token::DisjunctivePreconditions,
        ":equality" => Token::Equality,
        ":existential-preconditions" => Token::ExistentialPreconditions,
        ":universal-preconditions" => Token::UniversalPreconditions,
        ":quantified-preconditions" => Token::QuantifiedPreconditions,
        ":conditional-effects" => Token::ConditionalEffects,
        ":fluents" => Token::Fluents,
        ":numeric-fluents" => Token::NumericFluents,
        ":object-fluents" => Token::ObjectFluents,
        ":adl" => Token::Adl,
        ":durative-actions" => Token::DurativeActions,
        ":duration-inequalities" => Token::DurationInequalities,
        ":continuous-effects" => Token::ContinuousEffects,
        ":derived-predicates" => Token::DerivedPredicates,
        ":timed-initial-literals" => Token::TimedInitialLiterals,
        ":preferences" => Token::Preferences,
        ":constraints" => Token::Constraints,
        ":action-costs" => Token::ActionCosts,

        // Time
        "at start" => Token::AtStart,
        "at end" => Token::AtEnd,
        "over all" => Token::OverAll,

        // Constraints
        "always" => Token::Always,
        "sometime" => Token::Sometime,
        "within" => Token::Within,
        "at-most-once" => Token::AtMostOnce,
        "sometime-after" => Token::SometimeAfter,
        "sometime-before" => Token::SometimeBefore,
        "always-within" => Token::AlwaysWithin,
        "hold-during" => Token::HoldDuring,
        "hold-after" => Token::HoldAfter,

        // Separators
        "(" => Token::LParen,
        ")" => Token::RParen,

        // Arithmetic operators
        "-" => Token::Sub,
        "+" => Token::Add,
        "/" => Token::Div,
        "*" => Token::Mul,

        // Comparison operators
        ">" => Token::Greater,
        "<" => Token::Less,
        "=" => Token::Equal,
        ">=" => Token::GreaterEq,
        "<=" => Token::LessEq,

        // Assign operators
        "assign" => Token::Assign,
        "scale-up" => Token::ScaleUp,
        "scale-down" => Token::ScaleDown,
        "increase" => Token::Increase,
        "decrease" => Token::Decrease,

        // Opitimization
        "minimize" => Token::Minimize,
        "maximize" => Token::Maximize,

        // Special
        "object_type" => Token::ObjectType,
        "number_type" => Token::NumberType,
        "undefined" => Token::Undefined,
        "?duration" => Token::DurationVariable,
        "#t" => Token::SharpT,
        "total-time" => Token::TotalTime,
        "is-violated" => Token::IsViolated,

        // Error
        "error" => Token::Error(<String>),

        // HDDL
        ":hierarchy" => Token::Hierarchy,
        ":method-preconditions" => Token::MethodPreconditions,
        ":task" => Token::Task,
        ":tasks" => Token::Tasks,
        ":method" => Token::Method,
        ":ordered-subtasks" => Token::OrderedSubtasks,
        ":ordered-tasks" => Token::OrderedTasks,
        ":subtasks" => Token::Subtasks,
        ":ordering" => Token::Ordering,
        ":order" => Token::Order,
        ":htn" => Token::Htn,
    }
}

pub Name : Result<AstContent, ()> = {
    <start:@L>  <name:"id"> <end:@R> => {
        if name.starts_with("?") {
            let parse_error = ParseError::UnrecognizedToken {
                token : (start, Token::ID(name), end),
                expected : vec!["\"id\"".to_string()],
            };
           let error_recovery = ErrorRecovery { error: parse_error, dropped_tokens: Vec::new() };
           context.push(error_recovery);
           Err(())
        } else {
            Ok(AstContent::Ident(context.intern(name.to_string())))
        }
    },
    <start:@L> <error:!> <end:@R>  => {
        context.push(error);
        Err(())
    },
    // Addition to allow the use of special symbols as ordinary symbols. The verification will be performed during
    // semantics analysis
    <start:@L> <name:"object_type"> <end:@R> => Ok(AstContent::Ident(context.intern(name.to_string()))),
    <start:@L> <name:"number_type"> <end:@R> => Ok(AstContent::Ident(context.intern(name.to_string()))),
    <start:@L> <name:"total-time"> <end:@R> => Ok(AstContent::Ident(context.intern(name.to_string()))),
}

pub VarName : Result<AstContent, ()> = {
    <start:@L>  <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            let parse_error = ParseError::UnrecognizedToken {
                token : (start, Token::ID(name), end),
                expected : vec!["\"?id\"".to_string()],
            };
           let error_recovery = ErrorRecovery { error: parse_error, dropped_tokens: Vec::new() };
           context.push(error_recovery);
           Err(())
        } else {
            Ok(AstContent::Ident(context.intern(name.to_string())))
        }
    },
    <start:@L> <error:!> <end:@R>  => {
        context.push(error);
        Err(())
    },
}

pub Constant: NodeId = {
    <start:@L> <name:Name> <end:@R> => match name {
        Ok(name) => context.new_node(AstKind::Constant, name, Vec::new(), start, end, None),
        Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None),
    }
}

pub Variable: NodeId = {
    <start:@L> <name:VarName> <end:@R> => {
        match name {
            Ok(name) => context.new_node(AstKind::Variable, name, Vec::new(), start, end, None),
            Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None),
        }
    },
    <var:DurationVariable> => var,
}

pub FunctionSymbol: NodeId = {
    <start:@L> <name:Name> <end:@R> => {
        match name {
            Ok(name) => context.new_node(AstKind::FunctionSymbol, name, Vec::new(), start, end, None),
            Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None),
        }
    },
}

pub Number: NodeId = {
    <start:@L> <value:"number"> <end:@R> => {
        context.new_node(AstKind::Number, AstContent::Float(OrderedFloat(value)), Vec::new(), start, end, None)
    },
}

pub DomainName: NodeId = {
    <start:@L> <name:Name> <end:@R> => match name {
        Ok(name) => context.new_node(AstKind::DomainName, name, Vec::new(), start, end, None),
        Err(_) => context.new_node(AstKind::Error, AstContent::None, Vec::new(), start, end, None),
    },
}

