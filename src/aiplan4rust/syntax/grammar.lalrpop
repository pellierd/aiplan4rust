pub PEffect: Result<NodeId, ParseContextError> = {
    <literal:Literal<Term>> => literal,
    <start:@L> "(" <op:AssignOp> <fhead:FHead> <fexp:_FExp> ")" <end:@R> => {
        context.alloc_node(AstKind::Assignment, op, vec![fhead?, fexp?], start, end)
    },
