pub DurationConstraint: NodeId = {
    <start:@L> "(" "and" <constraints:SimpleDurationConstraint*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, constraints, start, end, None)
    },
    <start:@L> "(" ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, vec![], start, end, None)
    },
    <constraint:SimpleDurationConstraint> => constraint,
}

pub SimpleDurationConstraint: NodeId = {
    <start:@L> "(" <op:DOp> <var:DurationVariable> <value:DValue> ")" <end:@R> => {
        context.new_node(AstKind::FComp, op, vec![var, value], start, end, None)
    },
    <start:@L> "at start" <constraints:SimpleDurationConstraint> <end:@R> => {
        context.new_node(AstKind::AtStart, AstContent::None, vec![constraints], start, end, None)
    },
    <start:@L> "at end" <constraints:SimpleDurationConstraint> <end:@R> => {
        context.new_node(AstKind::AtEnd, AstContent::None, vec![constraints], start, end, None)
    },
}

pub DurationVariable: NodeId = {
    <start:@L> <var:"?duration"> <end:@R> => {
        context.new_node(AstKind::Variable, AstContent::Ident(context.intern(var.to_string())), vec![], start, end, None)
    }
}

pub DOp : AstContent = {
    ">=" =>AstContent::BinaryComp(BinaryComp::GreaterEq),
    "<=" =>AstContent::BinaryComp(BinaryComp::LessEq),
    "=" =>AstContent::BinaryComp(BinaryComp::Equal),
}

pub DValue: NodeId = {
    <fexp:FExp> => fexp,
}

pub DAGD: NodeId = {
    <pref_timed_gd:PrefTimedGD> => pref_timed_gd,
    <start:@L> "(" "and" <da_gd:DAGD*> ")" <end:@R> => {
        context.new_node(AstKind::And, AstContent::None, da_gd, start, end, None)
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <da_gd:DAGD>
        ")"
    <end:@R> => {
        context.new_node(AstKind::Forall, AstContent::None, vec![variables, da_gd], start, end, None)
    },
}

pub PrefTimedGD: NodeId = {
    <timed_gd:TimedGD> => timed_gd,
    <start:@L> "(" "preference" <pref_name:PrefName?> <timed_gd:TimedGD> ")" <end:@R> => {
        let mut children = Vec::new();
        if let Some(pref_name) = pref_name {
            children.push(pref_name);
        }
        children.push(timed_gd);
        context.new_node(AstKind::Preference, AstContent::None, children, start, end, None)
    },
}

pub TimedGD: NodeId = {
    <start:@L> "(" "at start" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::AtStart, AstContent::None, vec![gd], start, end, None)
    },
    <start:@L> "(" "at end" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::AtEnd, AstContent::None, vec![gd], start, end, None)
    },
    <start:@L> "(" "over all" <gd:GD> ")" <end:@R> => {
        context.new_node(AstKind::Overall, AstContent::None, vec![gd], start, end, None)
    },
}

