pub AtomicFunctionSkeleton:  Result<NodeId, ParseContextError> = {
    <start:@L> "(" <functor:FunctionSymbol> <arguments:TypedList<Variable>> ")" <end:@R> => {
        context.alloc_node(AstKind::AtomicFunctionSkeleton, AstContent::None, vec![functor?, arguments?], start, end)
    }
