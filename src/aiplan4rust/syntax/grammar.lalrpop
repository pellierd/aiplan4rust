AtomicFormula<T>: Result<NodeId, ParseContextError> = {
    <start:@L> "(" <predicate:Predicate> <terms:T*> ")" <end:@R> => {
        let terms = terms.into_iter().collect::<Result<Vec<_>, _>>()?;
        let mut children = Vec::new();
        children.push(predicate?);
        children.extend(terms);
        context.alloc_node(AstKind::AtomicFormula, AstContent::None, children, start, end)
    }
