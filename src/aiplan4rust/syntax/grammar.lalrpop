pub Term: Box<IntAstNode> = {
    <start:@L> <name:"id"> <end:@R> => {
        if !name.starts_with("?") {
            Box::new(IntAstNode::new(IntAstKind::Constant, AstContent::Ident(name), Vec::new(), start, end))
        } else {
            Box::new(IntAstNode::new(IntAstKind::Variable, AstContent::Ident(name), Vec::new(), start, end))
        }
    },
    <duration:DurationVariable> => duration,
    <function:FunctionTerm> => function,
}

pub FunctionTerm: Box<IntAstNode> = {
    <function_term:_FunctionTerm<Term>> => function_term
}

_FunctionTerm<T>: Box<IntAstNode> = {
   <start:@L> "(" <function_symbol:FunctionSymbol> <arguments:T*> ")" <end:@R> => {
            let mut children = Vec::new();
            children.push(function_symbol);
            children.extend(arguments);
            Box::new(IntAstNode::new(IntAstKind::FunctionTerm, AstContent::None, children, start, end))
       },
}

pub FComp : Box<IntAstNode> = {
    <start:@L> "(" <comparator:BinaryComp> <arg1:_FExp> <arg2:_FExp> ")"  <end:@R> => {
        let mut children = Vec::new();
         children.push(arg1);
         children.push(arg2);
         Box::new(IntAstNode::new(IntAstKind::FComp, comparator, children, start, end))
    },
}

pub BinaryComp :AstContent = {
    ">" =>AstContent::Comparison(BinaryComp::Greater),
    "<" =>AstContent::Comparison(BinaryComp::Less),
    "=" =>AstContent::Comparison(BinaryComp::Equal),
    ">=" =>AstContent::Comparison(BinaryComp::GreaterEq),
    "<=" =>AstContent::Comparison(BinaryComp::LessEq),
}

pub AssignOp :AstContent = {
    "assign" =>AstContent::Assign(AssignOp::Assign),
    "scale-up" =>AstContent::Assign(AssignOp::ScaleUp),
    "scale-down" =>AstContent::Assign(AssignOp::ScaleDown),
    "increase" =>AstContent::Assign(AssignOp::Increase),
    "decrease" =>AstContent::Assign(AssignOp::Decrease),
}

pub ArithmeticOp :AstContent = {
    "-" =>AstContent::Operation(ArithmeticOp::Sub),
    "+" =>AstContent::Operation(ArithmeticOp::Add),
    "/" =>AstContent::Operation(ArithmeticOp::Div),
    "*" =>AstContent::Operation(ArithmeticOp::Mul),
}

Literal<T> : Box<IntAstNode> = {
    <atom:AtomicFormula<T>> => atom,
    <start:@L> "(" "not" <atom:AtomicFormula<T>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(atom);
        Box::new(IntAstNode::new(IntAstKind::Not, AstContent::None, children, start, end))
    },
}

AtomicFormula<T> : Box<IntAstNode> = {
    <start:@L> "(" <predicate:Predicate> <terms:T*> ")"  <end:@R> => {
        let mut children = Vec::new();
        children.push(predicate);
        children.extend(terms);
        Box::new(IntAstNode::new(IntAstKind::AtomicFormula, AstContent::None, children, start, end))
    },
}

_FExp : Box<IntAstNode> = {
    <term:Term> => term,
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:_FExp> <arg2:_FExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Sub), children, start, end))
    },
    <start:@L> "(" "/" <arg1:_FExp> <arg2:_FExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.push(arg2);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Div), children, start, end))
    },
    <start:@L> "(" "+" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Add), children, start, end))
    },
    <start:@L> "(" "*" <arg1:_FExp> <next_args:_FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Mul), children, start, end))
    },
}

pub FExp : Box<IntAstNode> = {
    <number:Number> => number,
    <start:@L> "(" "-" <arg1:FExp> <arg2:FExp?> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        if let Some(arg2) = arg2 {
            children.push(arg2);
        }
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Sub), children, start, end))
    },
    <start:@L> "(" "/" <arg1:FExp> <arg2:FExp> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.push(arg2);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Div), children, start, end))
    },
    <start:@L> "(" "+" <arg1:FExp> <next_args:FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Add), children, start, end))
    },
    <start:@L> "(" "*" <arg1:FExp> <next_args:FExp+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(arg1);
        children.extend(next_args);
        Box::new(IntAstNode::new(IntAstKind::Operation, AstContent::Operation(ArithmeticOp::Mul), children, start, end))
    },
    <fhead:FHead> => fhead,
}

