TypedList<T>: Box<IntAstNode> = {
   <start:@L>  <elements:T*> <end:@R> => {
        let typed_item_elt = Box::new(IntAstNode::new(IntAstKind::TypedItemElements, AstContent::None, elements, start, end));
        let typed_item = Box::new(IntAstNode::new(IntAstKind::TypedItem, AstContent::None, vec![typed_item_elt], start, end));
        Box::new(IntAstNode::new(IntAstKind::TypedList, AstContent::None, vec![typed_item], start, end))
   },
   <start:@L> <elements:T+> <end_elements:@R> "-" <ty:Type> <end_typed_item:@R> <mut next:TypedList<T>> <end:@R> => {
        let typed_item_elt = Box::new(IntAstNode::new(IntAstKind::TypedItemElements, AstContent::None, elements, start, end_elements));
        let typed_item = Box::new(IntAstNode::new(IntAstKind::TypedItem, AstContent::None, vec![typed_item_elt, ty], start, end_typed_item));
        let mut typed_list = Box::new(IntAstNode::new(IntAstKind::TypedList, AstContent::None, vec![typed_item], start, end));
        if let Some(first_child) = next.children().get(0) {
           if !first_child.children().is_empty() {
               typed_list.children_mut().extend(next.children_mut().drain(..));
           }
       }
        typed_list
    },
}

pub TypesDef : Box<IntAstNode> = {
    <start:@L> "(" ":types" <types:TypedList<PrimitiveType>> ")" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::TypesDef, AstContent::None, vec![types] , start, end))
     },
}

pub ConstantsDef : Box<IntAstNode> = {
    <start:@L> "(" ":constants" <constants:TypedList<Constant>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(constants);
        Box::new(IntAstNode::new(IntAstKind::ConstantsDef, AstContent::None, children , start, end))
     },
}

pub PredicatesDef : Box<IntAstNode> = {
     <start:@L> "(" ":predicates" <predicates:AtomicFormulaSkeleton+> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(predicates);
        Box::new(IntAstNode::new(IntAstKind::PredicatesDef, AstContent::None, children , start, end))
    },
}
pub AtomicFormulaSkeleton : Box<IntAstNode> = {
    <start:@L> "(" <predicate:Predicate> <arguments:TypedList<Variable>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(predicate);
        children.push(arguments);
        Box::new(IntAstNode::new(IntAstKind::AtomicFormulaSkeleton, AstContent::None, children , start, end))
    }
}

pub FunctionsDef :  Box<IntAstNode> = {
    <start:@L> "(" ":functions" <functions:TypedList<AtomicFunctionSkeleton>>  ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(functions);
        Box::new(IntAstNode::new(IntAstKind::FunctionsDef, AstContent::None, children , start, end))
    }
}

pub AtomicFunctionSkeleton : Box<IntAstNode> = {
    <start:@L> "(" <functor:FunctionSymbol> <arguments:TypedList<Variable>> ")" <end:@R> => {
        let mut children = Vec::new();
        children.push(functor);
        children.push(arguments);
        Box::new(IntAstNode::new(IntAstKind::AtomicFunctionSkeleton, AstContent::None, children , start, end))
    }
}

pub StructureDef : Box<IntAstNode> = {
    <action:ActionDef> =>  action,
    <derived:DerivedDef> => derived,
    <durative_action:DurativeActionDef> => durative_action,
}

pub ActionDef : Box<IntAstNode> = {
    <start:@L>
        "(" ":action"
            <name:ActionSymbol>
            <parameters:ParameterDef>
            <body:ActionDefBody>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(name);
        children.push(parameters);
        children.push(body);
        Box::new(IntAstNode::new(IntAstKind::ActionDef, AstContent::None, children , start, end))
    }
}

pub ParameterDef : Box<IntAstNode> = {
    <start:@L>
       ":parameters" "(" <parameters:TypedList<Variable>> ")"
    <end:@R>  => parameters,
}

pub ActionDefBody : Box<IntAstNode> = {
    <start:@L>
        <precondition:PreconditionDef?>
        <effect:EffectDef?>
    <end:@R>  => {
        let mut children = Vec::new();
        if let Some(precondition) = precondition {
            children.push(precondition);
        }
        if let Some(effect) = effect {
            children.push(effect);
        }
        Box::new(IntAstNode::new(IntAstKind::ActionDefBody, AstContent::None, children , start, end))
    }
}

pub PreconditionDef : Box<IntAstNode> = {
    <start:@L>
        ":precondition" <precondition:EmptyOr<PreGD>>
    <end:@R>  => {
        let mut children = Vec::new();
        children.push(precondition);
        Box::new(IntAstNode::new(IntAstKind::PreconditionDef, AstContent::None, children , start, end))
    }
}

pub EffectDef : Box<IntAstNode> = {
    <start:@L>
        ":effect" <effect:EmptyOr<Effect>>
    <end:@R>  => {
        let mut children = Vec::new();
        children.push(effect);
        Box::new(IntAstNode::new(IntAstKind::EffectDef, AstContent::None, children , start, end))
    }
}

EmptyOr<T> : Box<IntAstNode> = {
    <start:@L> "(" ")" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Or, AstContent::None, Vec::new(), start, end))
    },
    <start:@L> <element:T> <end:@R> => {
        let mut children = Vec::new();
        children.push(element);
        Box::new(IntAstNode::new(IntAstKind::Or, AstContent::None, children, start, end))
    },
}

pub PreGD : Box<IntAstNode> = {
    <start:@L> <pref_gd:PrefGD> <end:@R> => pref_gd,
    //<start:@L> <gd:GD> <end:@R> => gd,
    <atom:AtomicFormula<Term>> => atom,
    <start:@L> "(" "and" <pre_gd:PreGD*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(pre_gd);
        Box::new(IntAstNode::new(IntAstKind::And, AstContent::None, children, start, end))
    },
    <start:@L> "(" "or" <gd:GD*> ")" <end:@R> => {
        let mut children = Vec::new();
        children.extend(gd);
        Box::new(IntAstNode::new(IntAstKind::Or, AstContent::None, children, start, end))
    },
    <start:@L> "(" "not" <gd:GD> ")" <end:@R> => {
         let mut children = Vec::new();
         children.push(gd);
         Box::new(IntAstNode::new(IntAstKind::Not, AstContent::None, children, start, end))
    },
    <start:@L> "(" "imply" <antecedent:GD> <consequence:GD>")" <end:@R>  => {
        let mut children = Vec::new();
        children.push(antecedent);
        children.push(consequence);
        Box::new(IntAstNode::new(IntAstKind::Imply, AstContent::None, children, start, end))
    },
    <start:@L>
        "(" "exists"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <gd:GD>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(gd);
        Box::new(IntAstNode::new(IntAstKind::Exists, AstContent::None, children, start, end))
    },
    <start:@L>
        "(" "forall"
            <start_var:@L> "(" <variables:TypedList<Variable>> ")" <end_var:@R>
            <pre_gd:PreGD>
        ")"
    <end:@R> => {
        let mut children = Vec::new();
        children.push(variables);
        children.push(pre_gd);
        Box::new(IntAstNode::new(IntAstKind::Forall, AstContent::None, children, start, end))
    },
    <fcomp:FComp> => fcomp,
}

pub PrefGD : Box<IntAstNode> = {
    <start:@L> "(" "preference" <pref_name:PrefName?> <gd:GD> ")" <end:@R> => {
