pub Requirement : Box<IntAstNode> = {
    <start:@L> ":strips" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::Strips), Vec::new(), start, end))
    },
    <start:@L> ":typing" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::Typing), Vec::new(), start, end))
    },
    <start:@L> ":equality" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::Equality), Vec::new(), start, end))
    },
    <start:@L> ":negative-preconditions" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::NegativePreconditions), Vec::new(), start, end))
    },
    <start:@L> ":disjunctive-preconditions" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::DisjunctivePreconditions), Vec::new(), start, end))
    },
    <start:@L> ":existential-preconditions" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::ExistentialPreconditions), Vec::new(), start, end))
    },
    <start:@L> ":universal-preconditions" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::UniversalPreconditions), Vec::new(), start, end))
    },
    <start:@L> ":quantified-preconditions" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::QuantifiedPreconditions), Vec::new(), start, end))
    },
    <start:@L> ":conditional-effects" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::ConditionalEffects), Vec::new(), start, end))
    },
    <start:@L> ":fluents" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::Fluents), Vec::new(), start, end))
    },
    <start:@L> ":numeric-fluents" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::NumericFluents), Vec::new(), start, end))
    },
    <start:@L> ":object-fluents" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::ObjectFluents), Vec::new(), start, end))
    },
    <start:@L> ":adl" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::Adl), Vec::new(), start, end))
    },
    <start:@L> ":durative-actions" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::DurativeActions), Vec::new(), start, end))
    },
    <start:@L> ":duration-inequalities" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::DurationInequalities), Vec::new(), start, end))
    },
    <start:@L> ":continuous-effects" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::ContinuousEffects), Vec::new(), start, end))
    },
    <start:@L> ":derived-predicates" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::DerivedPredicates), Vec::new(), start, end))
    },
    <start:@L> ":timed-initial-literals" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::TimedInitialLiterals), Vec::new(), start, end))
    },
    <start:@L> ":preferences" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::Preferences), Vec::new(), start, end))
    },
    <start:@L> ":constraints" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::Constraints), Vec::new(), start, end))
    },
    <start:@L> ":action-costs" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Requirement, AstContent::Requirement(Requirement::ActionCosts), Vec::new(), start, end))
    },
    <start:@L> <error:!> <end:@R>  => {
        errors.push(error);
        Box::new(IntAstNode::new(IntAstKind::Error, AstContent::None, Vec::new(), start, end))
    },
}

pub RequireDef : Box<IntAstNode> = {
     <start:@L> "(" ":requirements" <requirements:Requirement*> ")" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::RequireDef, AstContent::None, requirements, start, end))
     },
}

pub Type : Box<IntAstNode> = {
    <start:@L> <ty:PrimitiveType> <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Type, AstContent::None, vec![ty], start, end))
    },
    <start:@L> "(" "either" <types:PrimitiveType+> ")" <end:@R> => {
        Box::new(IntAstNode::new(IntAstKind::Type, AstContent::None, types, start, end))
    },
}

